{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="float-end">
                <button type="submit" form="form-settings" class="btn btn-primary">
                    <i class="fas fa-regular fa-floppy-disk"></i> {{ button_save }}
                </button>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        <div class="settings-card">
            <div class="card-header">
                <i class="fas fa-solid fa-user-gear"></i> User Role Settings
            </div>
            <div class="card-body">
                <form id="form-settings" action="{{ action }}" method="post">
                    
                    <div class="form-group">
                        <label for="manager_group_id">Manager Customer Group</label>
                        <select name="manager_group_id" id="manager_group_id" class="form-select">
                            <option value="">-- Select Customer Group --</option>
                            {% for group in customer_groups %}
                                <option value="{{ group.customer_group_id }}" 
                                    {{ manager_group_id == group.customer_group_id ? 'selected' : '' }}>
                                    {{ group.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="help-text">Users with this customer group will have Manager access</div>
                    </div>
                    
                    <div class="form-group">
                        <label for="accountant_group_id">Accountant Customer Group</label>
                        <select name="accountant_group_id" id="accountant_group_id" class="form-select">
                            <option value="">-- Select Customer Group --</option>
                            {% for group in customer_groups %}
                                <option value="{{ group.customer_group_id }}" 
                                    {{ accountant_group_id == group.customer_group_id ? 'selected' : '' }}>
                                    {{ group.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="help-text">Users with this customer group will have Accountant access</div>
                    </div>
                    
                    <div class="form-group">
                        <label for="shareholder_group_id">Shareholder Customer Group</label>
                        <select name="shareholder_group_id" id="shareholder_group_id" class="form-select">
                            <option value="">-- Select Customer Group --</option>
                            {% for group in customer_groups %}
                                <option value="{{ group.customer_group_id }}" 
                                    {{ shareholder_group_id == group.customer_group_id ? 'selected' : '' }}>
                                    {{ group.name }}
                                </option>
                            {% endfor %}
                        </select>
                        <div class="help-text">Users with this customer group will have Shareholder access</div>
                    </div>
                    
                    <div class="alert alert-info">
                        <i class="fas fa-regular fa-circle-info"></i>
                        <strong>Note:</strong> These settings are used to determine user roles throughout the PMS system.
                        Please ensure the correct customer groups are selected.
                    </div>
                    
                    <input type="hidden" name="user_token" value="{{ user_token }}">
                </form>
            </div>
        </div>
    </div>
</div>

{{ footer }}