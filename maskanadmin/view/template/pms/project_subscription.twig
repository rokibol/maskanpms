{{ header }}{{ column_left }}

<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <a href="{{ back }}" class="btn btn-secondary">
            <i class="fas fa-solid fa-arrow-left"></i> {{ button_back }}
        </a>
      </div>
      <h1>{{ heading_title }} - {{ project.name }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    <!-- Current Status Card -->
    <div class="card">
        <div class="card-header">
            <i class="fas fa-solid fa-chart-line"></i> Current Subscription Status
        </div>
        <div class="card-body">
            {% if current_subscription %}
                <div class="row">
                    <div class="col-md-4">
                        <div class="mb-2">
                            <strong>Status:</strong>
                        </div>
                        <div>
                            {% if current_subscription.admin_override %}
                                <span class="status-badge status-override">Admin Override Active</span>
                            {% elseif current_subscription.end_date and date(current_subscription.end_date) > date() %}
                                <mark class="bg-success text-white px-2">Activated and Subscription is valid.</mark>
                            {% else %}
                                <mark class="bg-danger text-white px-2">Subscription has expired or does not exist.</mark>
                            {% endif %}

                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-2">
                            <strong>Expires on:</strong>
                        </div>
                        <div>{{ current_subscription.end_date|date('d M Y') }}</div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-2">
                            <strong>Days Remaining:</strong>
                        </div>
                        <div>
                            {% set days_left = (current_subscription.end_date|date('U') - date()|date('U')) / 86400 %}
                            {% if days_left > 0 %}
                                <span class="fw-bold">{{ days_left|round }} days</span>
                            {% else %}
                                <span class="text-danger">Expired</span>
                            {% endif %}
                        </div>
                    </div>
                </div>
                {% if current_subscription.admin_override %}
                    <div class="row mt-3">
                        <div class="col-md-12">
                            <div class="alert alert-info">
                                <i class="fas fa-regular fa-circle-info"></i>
                                <strong>Admin Override Active</strong><br>
                                Reason: {{ current_subscription.override_reason }}<br>
                                Override expires: {{ current_subscription.override_until|date('d M Y') }}
                            </div>
                        </div>
                    </div>
                {% endif %}
            {% else %}
                <div class="alert alert-warning">
                    <i class="fas fa-regular fa-circle-exclamation"></i>
                    No active subscription found for this project.
                </div>
            {% endif %}
        </div>
    </div>
    <!-- Add New Subscription -->
    <div class="card">
        <div class="card-header">
            <i class="fas fa-solid fa-plus"></i> Add / Extend Subscription
        </div>
        <div class="card-body">
            <form id="form-add" action="{{ action_add }}" method="post">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Select Duration</label>
                        <select name="duration_months" class="form-select" required>
                            <option value="">-- Select Duration --</option>
                            {% for months, label in duration_options %}
                                <option value="{{ months }}">{{ label }} - ৳ {{ months * monthly_rate }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-solid fa-arrow-right"></i> Activate
                        </button>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <small class="text-muted">
                            <i class="fas fa-regular fa-circle-info"></i>
                            Monthly rate: ৳ {{ monthly_rate|number_format(0) }} per month
                        </small>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <!-- Admin Override (if active subscription exists) -->
    {% if current_subscription %}
    <div class="card">
        <div class="card-header">
            <i class="fas fa-solid fa-gear"></i> Admin Override
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-12">
                    <form id="form-override" action="{{ action_override }}" method="post">
                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">Extend by</label>
                                <select name="override_months" class="form-select" required>
                                    <option value="">-- Select --</option>
                                    <option value="1">1 Month</option>
                                    <option value="3">3 Months</option>
                                    <option value="6">6 Months</option>
                                    <option value="12">12 Months</option>
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label">Reason for Override</label>
                                <input type="text" name="override_reason" id="override_reason" class="form-control" placeholder="Enter reason" required>
                            </div>
                            <div class="col-md-2">
                                <button type="submit" class="btn btn-warning w-100">
                                    <i class="fas fa-solid fa-arrow-up"></i> Add Override
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
            {% if current_subscription.admin_override %}
            <div class="row mt-3">
                <div class="col-md-12">
                    <form id="form-remove-override" action="{{ action_remove }}" method="post">
                        <input type="hidden" name="subscription_id" value="{{ current_subscription.subscription_id }}">
                        <button type="button" class="btn btn-danger" onclick="showRemoveOverrideConfirm()">
                            <i class="fas fa-regular fa-trash-can"></i> Remove Override
                        </button>
                    </form>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
    {% endif %}
    <!-- Subscription History -->
    <div class="card">
        <div class="card-header">
            <i class="fas fa-solid fa-history"></i> Subscription History
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Duration</th>
                            <th>Amount</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Status</th>
                            <th>Override</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if subscriptions %}
                            {% for sub in subscriptions %}
                                <tr>
                                    <td>{{ sub.created_at }}</td>
                                    <td>{{ sub.duration_months }} month(s)</td>
                                    <td>৳ {{ sub.total_amount|number_format(2) }}</td>
                                    <td>{{ sub.start_date }}</td>
                                    <td>{{ sub.end_date }}</td>
                                    <td>
                                        <span class="status-badge status-{{ sub.status_class }}">{{ sub.status_text }}</span>
                                    </td>
                                    <td>
                                        {% if sub.admin_override %}
                                            <span class="badge bg-info">Yes</span>
                                            <br><small>Until: {{ sub.override_until }}</small>
                                        {% else %}
                                            <span class="badge bg-secondary">No</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="7" class="text-center">No subscription history found</td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
  </div>
</div>
<!-- Add Activation Confirmation Modal -->
<div class="modal fade" id="addActivateModal" tabindex="-1">
    <div class="modal-dialog modal-confirm">
        <div class="modal-content">
            <div class="modal-header">
                <div class="icon-box warning">
                    <i class="fas fa-solid fa-exclamation-triangle"></i>
                </div>
            </div>
            <div class="modal-body">
                <h4>Confirm Admin Activation</h4>
                <p>Are you sure you want to activate this project on behalf of the project manager?</p>
                <div class="alert alert-info mt-3">
                    <strong>Activation Details:</strong><br>
                    Duration: <span id="confirm-activate-months"></span>
                </div>
                <p class="text-warning small">This will extend the subscription period and cannot be undone without override the activation period.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirm-activation">Confirm Activation</button>
            </div>
        </div>
    </div>
</div>
<!-- Add Override Confirmation Modal -->
<div class="modal fade" id="addOverrideModal" tabindex="-1">
    <div class="modal-dialog modal-confirm">
        <div class="modal-content">
            <div class="modal-header">
                <div class="icon-box warning">
                    <i class="fas fa-solid fa-exclamation-triangle"></i>
                </div>
            </div>
            <div class="modal-body">
                <h4>Confirm Admin Override</h4>
                <p>Are you sure you want to add an admin override for this project?</p>
                <div class="alert alert-info mt-3">
                    <strong>Override Details:</strong><br>
                    Duration: <span id="confirm-override-months"></span><br>
                    Reason: <span id="confirm-override-reason"></span>
                </div>
                <p class="text-warning small">This will extend the subscription period and cannot be undone without removing the override.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-warning" id="confirm-add-override">Confirm Override</button>
            </div>
        </div>
    </div>
</div>

<!-- Remove Override Confirmation Modal -->
<div class="modal fade" id="removeOverrideModal" tabindex="-1">
    <div class="modal-dialog modal-confirm">
        <div class="modal-content">
            <div class="modal-header">
                <div class="icon-box danger">
                    <i class="fas fa-solid fa-trash-can"></i>
                </div>
            </div>
            <div class="modal-body">
                <h4>Confirm Removal</h4>
                <p>Are you sure you want to remove the admin override?</p>
                <div class="alert alert-warning mt-3">
                    <strong>Warning:</strong><br>
                    Removing the override will revert to the original subscription expiry date.
                    {% if current_subscription %}
                        Original expiry: <strong>{{ current_subscription.end_date|date('d M Y') }}</strong>
                    {% endif %}
                </div>
                <p class="text-danger small">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirm-remove-override">Confirm Removal</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
const activate_form = document.getElementById('form-add');
// 1. Intercept the form submission
activate_form.addEventListener('submit', function(event) {
    // Check if the form is already validated and ready to go
    console.log("stop submission");
    event.preventDefault(); // Stop the form from submitting immediately
    showActivationConfirm();      // Open the confirmation modal
});


// Add Override Confirmation
function showActivationConfirm() {
    
    var months = $('select[name="duration_months"]').val();
    
    if (!months) {
        alert('Please select extension duration');
        return false;
    }
    
    // Set confirmation modal text
    var monthText = '';
    switch(months) {
        case '1': monthText = '1 Month'; break;
        case '3': monthText = '3 Months'; break;
        case '6': monthText = '6 Months'; break;
        case '12': monthText = '12 Months'; break;
        default: monthText = months + ' Months';
    }
    
    document.getElementById('confirm-activate-months').innerText = monthText;
    
    $('#addActivateModal').modal('show');
}

$('#confirm-activation').on('click', function() {
    var actionUrl = $('#form-add').attr('action');
    var element = $('#form-add');
    
    $.ajax({
        url: actionUrl.replaceAll('&amp;', '&'),
        type: 'POST',
        data: $('#form-add').serialize(),
        dataType: 'json',
        contentType: 'application/x-www-form-urlencoded',
        beforeSend: function() {
            $('#confirm-activation').button('loading');
        },
        complete: function() {
            $('#confirm-activation').button('reset');
        },
        success: function(json, textStatus) {
            $('.alert-dismissible').remove();
            $(element).find('.is-invalid').removeClass('is-invalid');
            $(element).find('.invalid-feedback').removeClass('d-block');

            if (json['redirect']) {
                location = json['redirect'];
            }

            if (typeof json['error'] == 'string') {
                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (typeof json['error'] == 'object') {
                if (json['error']['warning']) {
                    $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + json['error']['warning'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
                }

                for (key in json['error']) {
                    $('#input-' + key.replaceAll('_', '-')).addClass('is-invalid').find('.form-control, .form-select, .form-check-input, .form-check-label').addClass('is-invalid');
                    $('#error-' + key.replaceAll('_', '-')).html(json['error'][key]).addClass('d-block');
                }
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');

                // Refresh
                var url = $(form).attr('data-oc-load');
                var target = $(form).attr('data-oc-target');

                if (url !== undefined && target !== undefined) {
                    $(target).load(url);
                }
            }
        },
        error: function(xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});

const form = document.getElementById('form-override');
// 1. Intercept the form submission
form.addEventListener('submit', function(event) {
    // Check if the form is already validated and ready to go
    console.log("stop submission");
    event.preventDefault(); // Stop the form from submitting immediately
    showAddOverrideConfirm();      // Open the confirmation modal
});

// Add Override Confirmation
function showAddOverrideConfirm() {
    
    var months = $('select[name="override_months"]').val();
    var reason = $('#override_reason').val();
    
    if (!months) {
        alert('Please select extension duration');
        return false;
    }
    if (!reason) {
        alert('Please enter a reason for the override');
        return false;
    }
    
    // Set confirmation modal text
    var monthText = '';
    switch(months) {
        case '1': monthText = '1 Month'; break;
        case '3': monthText = '3 Months'; break;
        case '6': monthText = '6 Months'; break;
        case '12': monthText = '12 Months'; break;
        default: monthText = months + ' Months';
    }
    
    document.getElementById('confirm-override-months').innerText = monthText;
    document.getElementById('confirm-override-reason').innerText = reason;
    
    $('#addOverrideModal').modal('show');
}

