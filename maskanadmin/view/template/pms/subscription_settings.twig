{{ header }}{{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
            <ol class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ol>
        </div>
    </div>

    <div class="container-fluid">
        <!-- Settings Card -->
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-gear"></i> {{ text_settings }}
            </div>
            <div class="card-body">
                <form action="{{ action }}" method="post" class="form-horizontal">
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Monthly Rate (BDT)</label>
                        <div class="col-sm-4">
                            <div class="input-group">
                                <input type="number" name="monthly_rate" value="{{ monthly_rate }}" class="form-control" step="1" min="0">
                                <button type="submit" class="btn btn-primary">Update Rate</button>
                            </div>
                            <small class="text-muted">Current rate: {{ monthly_rate }} BDT per month</small>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Add this after monthly rate section -->
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-tag"></i> Discount Settings
            </div>
            <div class="card-body">
                <form action="{{ action }}" method="post" class="form-horizontal">
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">Discount Type</label>
                        <div class="col-sm-9">
                            <select name="discount_type" class="form-select">
                                <option value="none" {{ discount_type == 'none' ? 'selected' : '' }}>No Discount</option>
                                <option value="percentage" {{ discount_type == 'percentage' ? 'selected' : '' }}>Percentage (%)</option>
                                <option value="fixed" {{ discount_type == 'fixed' ? 'selected' : '' }}>Fixed Amount (BDT)</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">Discount Value</label>
                        <div class="col-sm-9">
                            <input type="number" name="discount_value" value="{{ discount_value }}" class="form-control" step="0.01" min="0">
                            <small class="text-muted">Percentage (%) or Fixed Amount (BDT) based on discount type</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-3 col-form-label">Minimum Apartments for Discount</label>
                        <div class="col-sm-9">
                            <input type="number" name="discount_min_apartments" value="{{ discount_min_apartments }}" class="form-control" min="0">
                            <small class="text-muted">Number of apartments required to qualify for discount</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-sm-9 offset-sm-3">
                            <button type="submit" class="btn btn-primary">Save Discount Settings</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

</script>

{{ footer }}