{{ header }} {{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="float-end">
                <a href="{{ add }}" data-bs-toggle="tooltip" title="{{ button_add }}" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                </a>
                <button type="button" data-bs-toggle="tooltip" title="{{ button_delete }}" class="btn btn-danger" onclick="confirm('{{ text_confirm }}') ? $('#form-plan').submit() : false;">
                    <i class="fa-regular fa-trash-can"></i>
                </button>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <i class="fa-solid fa-list"></i> {{ text_list }}
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <form id="form-plan" action="{{ delete }}" method="post">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th style="width: 1px;" class="text-center"><input type="checkbox" onclick="$('input[name*=\'selected\']').prop('checked', this.checked);"></th>
                                    <th>{{ column_name }}</th>
                                    <th>{{ column_monthly_price }}</th>
                                    <th>{{ column_yearly_price }}</th>
                                    <th>{{ column_max_projects }}</th>
                                    <th>{{ column_max_shareholders }}</th>
                                    <th>{{ column_max_apartments }}</th>
                                    <th>{{ column_status }}</th>
                                    <th>{{ column_sort_order }}</th>
                                    <th class="text-end">{{ column_action }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if plans %}
                                    {% for plan in plans %}
                                        <tr>
                                            <td class="text-center">
                                                <input type="checkbox" name="selected[]" value="{{ plan.plan_id }}">
                                            </td>
                                            <td>{{ plan.name }}</td>
                                            <td>৳ {{ plan.price_monthly|number_format(2) }}</td>
                                            <td>৳ {{ plan.price_yearly|number_format(2) }}</td>
                                            <td>{{ plan.max_projects }}</td>
                                            <td>{{ plan.max_shareholders }}</td>
                                            <td>{{ plan.max_apartments }}</td>
                                            <td>
                                                {% if plan.is_active %}
                                                    <span class="badge bg-success">Active</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Inactive</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ plan.sort_order }}</td>
                                            <td class="text-end">
                                                <a href="{{ plan.edit }}" class="btn btn-primary btn-sm">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% else %}
                                    <tr>
                                        <td colspan="10" class="text-center">{{ text_no_results }}</td>
                                    </tr>
                                {% endif %}
                            </tbody>
                        </table>
                    </form>
                </div>
                <div class="row">
                    <div class="col-sm-6 text-start">{{ pagination }}</div>
                    <div class="col-sm-6 text-end">{{ results }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

{{ footer }}