{{ header }} {{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="float-end">
                <a href="{{ edit }}" class="btn btn-primary">
                    <i class="fa-regular fa-pen-to-square"></i> {{ button_edit }}
                </a>
                <a href="{{ back }}" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> {{ button_back }}
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        <div class="view-header">
            <h1><i class="fa-solid fa-building"></i> {{ name }}</h1>
            <p>{{ slug }}</p>
        </div>
        <div class="info-card">
            <div class="info-card-header">
                <i class="fa-solid fa-chart-line"></i> Project Statistics
            </div>
        </div>
        <!-- Stats Cards Row -->
        <div class="stats-container">
            <!-- Shareholders Stat -->
            <div class="stat-card primary">
                <div class="stat-icon">
                    <i class="fa-solid fa-users"></i>
                </div>
                <div class="stat-label">Total Shareholders</div>
                <div class="stat-number">{{ stats.total_shareholders }}</div>
                <div class="stat-sub">Active investors</div>
            </div>

            <!-- Apartments Stat -->
            <div class="stat-card info">
                <div class="stat-icon">
                    <i class="fa-solid fa-building"></i>
                </div>
                <div class="stat-label">Total Apartments</div>
                <div class="stat-number">{{ stats.total_apartments }}</div>
                <div class="stat-sub">
                    <span class="text-success">{{ stats.assigned_apartments }} assigned</span> | 
                    <span class="text-warning">{{ stats.available_apartments }} available</span>
                </div>
            </div>

            <!-- Expenses Stat -->
            <div class="stat-card danger">
                <div class="stat-icon">
                    <i class="fa-solid fa-receipt"></i>
                </div>
                <div class="stat-label">Total Expenses</div>
                <div class="stat-number">৳ {{ stats.total_expense_amount|number_format(0) }}</div>
                <div class="stat-sub">{{ stats.total_expenses }} transactions</div>
            </div>

            <!-- Collections Stat -->
            <div class="stat-card success">
                <div class="stat-icon">
                    <i class="fa-solid fa-credit-card"></i>
                </div>
                <div class="stat-label">Total Collections</div>
                <div class="stat-number">৳ {{ stats.total_payment_amount|number_format(0) }}</div>
                <div class="stat-sub">{{ stats.total_payments }} payments received</div>
            </div>
        </div>

        <!-- Second Row - Financial Stats -->
        <div class="stats-container">
            <!-- Outstanding Dues -->
            <div class="stat-card warning">
                <div class="stat-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div class="stat-label">Outstanding Dues</div>
                <div class="stat-number">৳ {{ stats.outstanding_dues|number_format(0) }}</div>
                <div class="progress-container">
                    <div class="progress-label">
                        <span>Collection Rate</span>
                        <span>{{ stats.collection_percentage }}%</span>
                    </div>
                    <div class="progress-bar-custom">
                        <div class="progress-fill" style="width: {{ stats.collection_percentage }}%;"></div>
                    </div>
                </div>
            </div>

            <!-- Total Shares -->
            <div class="stat-card primary">
                <div class="stat-icon">
                    <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div class="stat-label">Total Shares</div>
                <div class="stat-number">{{ total_shares }}</div>
                <div class="stat-sub">Total ownership units</div>
            </div>

            <!-- Share Value -->
            <div class="stat-card info">
                <div class="stat-icon">
                    <i class="fa-solid fa-chart-line"></i>
                </div>
                <div class="stat-label">Share Value</div>
                <div class="stat-number">৳ {{ share_value != '-' ? share_value|number_format(2) : 'N/A' }}</div>
                <div class="stat-sub">Per share unit</div>
            </div>

            <!-- Project Value -->
            <div class="stat-card success">
                <div class="stat-icon">
                    <i class="fa-solid fa-chart-simple"></i>
                </div>
                <div class="stat-label">Total Project Value</div>
                <div class="stat-number">
                    {% if share_value != '-' %}
                        ৳ {{ (total_shares * share_value|replace({',': ''}))|number_format(0) }}
                    {% else %}
                        N/A
                    {% endif %}
                </div>
                <div class="stat-sub">Based on share value</div>
            </div>
        </div>

        <!-- Tabs -->
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a href="#tab-general" data-bs-toggle="tab" class="nav-link active">
                    <i class="fa-solid fa-info-circle"></i> General Information
                </a>
            </li>
            <li class="nav-item">
                <a href="#tab-address" data-bs-toggle="tab" class="nav-link">
                    <i class="fa-solid fa-location-dot"></i> Address
                </a>
            </li>
            <li class="nav-item">
                <a href="#tab-dates" data-bs-toggle="tab" class="nav-link">
                    <i class="fa-regular fa-calendar"></i> Dates & Timeline
                </a>
            </li>
            <li class="nav-item">
                <a href="#tab-financial" data-bs-toggle="tab" class="nav-link">
                    <i class="fa-solid fa-chart-pie"></i> Financial
                </a>
            </li>
            <li class="nav-item">
                <a href="#tab-users" data-bs-toggle="tab" class="nav-link">
                    <i class="fa-solid fa-users"></i> Project Users
                </a>
            </li>
        </ul>

        <div class="tab-content">
            
            <!-- Tab 1: General Information -->
            <div class="tab-pane active" id="tab-general">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-building"></i> Basic Information
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <div class="info-label">Project Name</div>
                            <div class="info-value"><strong>{{ name }}</strong></div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Slug (URL)</div>
                            <div class="info-value">{{ slug }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Description</div>
                            <div class="info-value">{{ description ?: '-' }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Theme Color</div>
                            <div class="info-value">
                                <span class="color-preview" style="background: {{ theme_color }};"></span>
                                {{ theme_color }}
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Store</div>
                            <div class="info-value">{{ store_name }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Project Status</div>
                            <div class="info-value">
                                <span class="status-badge status-{{ status|lower|replace({' ': '_'}) }}">
                                    {{ status }}
                                </span>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Completion Percentage</div>
                            <div class="info-value">
                                <div class="progress-bar-custom" style="width: 200px; display: inline-block;">
                                    <div class="progress-fill" style="width: {{ completion_percentage }}%; background: #1F8A4D;"></div>
                                </div>
                                <span class="ms-2">{{ completion_percentage }}%</span>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Active Status</div>
                            <div class="info-value">
                                {% if is_active == 'Enabled' %}
                                    <span class="status-badge" style="background: #e8f5e9; color: #2e7d32;">Active</span>
                                {% else %}
                                    <span class="status-badge" style="background: #ffebee; color: #c62828;">Inactive</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Created Date</div>
                            <div class="info-value">{{ created_at }}</div>
                        </div>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-envelope"></i> Contact Information
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <div class="info-label">Contact Email</div>
                            <div class="info-value">
                                <a href="mailto:{{ contact_email }}">{{ contact_email }}</a>
                            </div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Contact Phone</div>
                            <div class="info-value">
                                <a href="tel:{{ contact_phone }}">{{ contact_phone }}</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 2: Address -->
            <div class="tab-pane" id="tab-address">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-location-dot"></i> Location Details
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <div class="info-label">Address</div>
                            <div class="info-value">{{ address|raw }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">City</div>
                            <div class="info-value">{{ city }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Postal Code</div>
                            <div class="info-value">{{ postal_code }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Country</div>
                            <div class="info-value">{{ country }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 3: Dates & Timeline -->
            <div class="tab-pane" id="tab-dates">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-regular fa-calendar"></i> Project Timeline
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <div class="info-label">Registration Date</div>
                            <div class="info-value">{{ registration_date }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Construction Start Date</div>
                            <div class="info-value">{{ construction_start_date }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Construction End Date</div>
                            <div class="info-value">{{ construction_end_date }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Handover Date</div>
                            <div class="info-value">{{ handover_date }}</div>
                        </div>
                    </div>
                </div>
                
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-chart-gantt"></i> Project Timeline Progress
                    </div>
                    <div class="info-card-body">
                        <div class="row text-center">
                            <div class="col-md-3">
                                <div class="small text-muted">Registration</div>
                                <div class="fw-bold">{{ registration_date != '-' ? registration_date : 'Pending' }}</div>
                            </div>
                            <div class="col-md-3">
                                <div class="small text-muted">Construction Start</div>
                                <div class="fw-bold">{{ construction_start_date != '-' ? construction_start_date : 'Pending' }}</div>
                            </div>
                            <div class="col-md-3">
                                <div class="small text-muted">Construction End</div>
                                <div class="fw-bold">{{ construction_end_date != '-' ? construction_end_date : 'Pending' }}</div>
                            </div>
                            <div class="col-md-3">
                                <div class="small text-muted">Handover</div>
                                <div class="fw-bold">{{ handover_date != '-' ? handover_date : 'Pending' }}</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 4: Financial -->
            <div class="tab-pane" id="tab-financial">
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-chart-pie"></i> Share Information
                    </div>
                    <div class="info-card-body">
                        <div class="info-row">
                            <div class="info-label">Total Shares</div>
                            <div class="info-value"><strong>{{ total_shares }}</strong> units</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Share Value</div>
                            <div class="info-value">{{ share_value != '-' ? '৳ ' ~ share_value : '-' }}</div>
                        </div>
                        <div class="info-row">
                            <div class="info-label">Total Project Value</div>
                            <div class="info-value">
                                {% if share_value != '-' %}
                                    ৳ {{ (total_shares * share_value|replace({',': ''}))|number_format(2) }}
                                {% else %}
                                    -
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>

                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-chart-simple"></i> Financial Summary
                    </div>
                    <div class="info-card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="info-row">
                                    <div class="info-label">Total Expenses</div>
                                    <div class="info-value text-danger">৳ {{ stats.total_expense_amount|number_format(2) }}</div>
                                </div>
                                <div class="info-row">
                                    <div class="info-label">Total Collected</div>
                                    <div class="info-value text-success">৳ {{ stats.total_payment_amount|number_format(2) }}</div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="info-row">
                                    <div class="info-label">Outstanding Dues</div>
                                    <div class="info-value text-warning">৳ {{ stats.outstanding_dues|number_format(2) }}</div>
                                </div>
                                <div class="info-row">
                                    <div class="info-label">Collection Rate</div>
                                    <div class="info-value">{{ stats.collection_percentage }}%</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tab 5: Project Users -->
            <div class="tab-pane" id="tab-users">
                <!-- Shareholders -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-users"></i> Shareholders ({{ project_users.shareholders|length }})
                    </div>
                    <div class="info-card-body">
                        {% if project_users.shareholders %}
                            <div class="table-responsive">
                                <table class="user-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone</th>
                                            <th>Ownership Units</th>
                                            <th>Shareholder Code</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for shareholder in project_users.shareholders %}
                                            <tr>
                                                <td>{{ shareholder.fullname }}</a>
                                                <td>{{ shareholder.email }}</a>
                                                <td>{{ shareholder.telephone ?: '-' }}</a>
                                                <td>{{ shareholder.ownership_units }} units</a>
                                                <td>{{ shareholder.shareholder_code }}</a>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p class="text-muted text-center py-3">No shareholders found for this project.</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Managers -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-user-tie"></i> Managers ({{ project_users.managers|length }})
                    </div>
                    <div class="info-card-body">
                        {% if project_users.managers %}
                            <div class="table-responsive">
                                <table class="user-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for manager in project_users.managers %}
                                            <tr>
                                                <td>{{ manager.fullname }}</a>
                                                <td>{{ manager.email }}</a>
                                                <td>{{ manager.telephone ?: '-' }}</a>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p class="text-muted text-center py-3">No managers assigned to this project.</p>
                        {% endif %}
                    </div>
                </div>

                <!-- Accountants -->
                <div class="info-card">
                    <div class="info-card-header">
                        <i class="fa-solid fa-user-gear"></i> Accountants ({{ project_users.accountants|length }})
                    </div>
                    <div class="info-card-body">
                        {% if project_users.accountants %}
                            <div class="table-responsive">
                                <table class="user-table">
                                    <thead>
                                        <tr>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Phone</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for accountant in project_users.accountants %}
                                            <tr>
                                                <td>{{ accountant.fullname }}</a>
                                                <td>{{ accountant.email }}</a>
                                                <td>{{ accountant.telephone ?: '-' }}</a>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p class="text-muted text-center py-3">No accountants assigned to this project.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            
        </div>
    </div>
</div>

{{ footer }}