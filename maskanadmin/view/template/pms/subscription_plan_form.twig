{{ header }} {{ column_left }}

<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <div class="float-end">
                <button type="submit" form="form-plan" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary">
                    <i class="fa-regular fa-floppy-disk"></i>
                </button>
                <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light">
                    <i class="fa-solid fa-reply"></i>
                </a>
            </div>
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        <form id="form-plan" action="{{ action }}" method="post" data-oc-toggle="ajax">
            <div class="card">
                <div class="card-header">
                    <i class="fa-solid fa-pencil"></i> {{ text_form }}
                </div>
                <div class="card-body">
                    <div class="row mb-3 required">
                        <label class="col-sm-2 col-form-label">Plan Name</label>
                        <div class="col-sm-10">
                            <input type="text" name="name" value="{{ name }}" class="form-control" required>
                        </div>
                    </div>
                    <div class="row mb-3 required">
                        <label class="col-sm-2 col-form-label">Slug</label>
                        <div class="col-sm-10">
                            <input type="text" name="slug" value="{{ slug }}" class="form-control" required>
                            <small class="text-muted">URL-friendly name (e.g., basic, professional)</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Description</label>
                        <div class="col-sm-10">
                            <textarea name="description" rows="3" class="form-control">{{ description }}</textarea>
                        </div>
                    </div>
                    <div class="row mb-3 required">
                        <label class="col-sm-2 col-form-label">Monthly Price (BDT)</label>
                        <div class="col-sm-10">
                            <input type="number" name="price_monthly" value="{{ price_monthly }}" class="form-control" step="0.01" min="0" required>
                        </div>
                    </div>
                    <div class="row mb-3 required">
                        <label class="col-sm-2 col-form-label">Yearly Price (BDT)</label>
                        <div class="col-sm-10">
                            <input type="number" name="price_yearly" value="{{ price_yearly }}" class="form-control" step="0.01" min="0" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Max Projects</label>
                        <div class="col-sm-10">
                            <input type="number" name="max_projects" value="{{ max_projects }}" class="form-control" min="1">
                            <small class="text-muted">Number of projects allowed (0 = unlimited)</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Max Shareholders</label>
                        <div class="col-sm-10">
                            <input type="number" name="max_shareholders" value="{{ max_shareholders }}" class="form-control" min="1">
                            <small class="text-muted">Maximum shareholders per project</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Max Apartments</label>
                        <div class="col-sm-10">
                            <input type="number" name="max_apartments" value="{{ max_apartments }}" class="form-control" min="1">
                            <small class="text-muted">Maximum apartments per project</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Features (JSON)</label>
                        <div class="col-sm-10">
                            <textarea name="features" rows="5" class="form-control" placeholder='{"feature1": "Unlimited Expenses", "feature2": "Payment Tracking"}'></textarea>
                            <small class="text-muted">JSON format: {"feature_key": "feature_value"}</small>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Status</label>
                        <div class="col-sm-10">
                            <select name="is_active" class="form-select">
                                <option value="1" {{ is_active == 1 ? 'selected' : '' }}>Active</option>
                                <option value="0" {{ is_active == 0 ? 'selected' : '' }}>Inactive</option>
                            </select>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label class="col-sm-2 col-form-label">Sort Order</label>
                        <div class="col-sm-10">
                            <input type="number" name="sort_order" value="{{ sort_order }}" class="form-control">
                        </div>
                    </div>
                </div>
            </div>
            
            <input type="hidden" name="user_token" value="{{ user_token }}">
        </form>
    </div>
</div>

{{ footer }}