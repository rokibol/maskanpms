{{ header }}{{ column_left }}
<div id="content">
    <div class="page-header">
        <div class="container-fluid">
            <h1>{{ heading_title }}</h1>
            <ul class="breadcrumb">
                {% for breadcrumb in breadcrumbs %}
                    <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
                {% endfor %}
            </ul>
        </div>
    </div>

    <div class="container-fluid">
        
        <!-- Tabs -->
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a href="{{ tab_all }}" class="nav-link {% if active_tab == 'all' %}active{% endif %}">
                    All <span class="tab-badge">{{ count_all }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ tab_pending }}" class="nav-link {% if active_tab == 'pending' %}active{% endif %}">
                    <i class="fas fa-regular fa-clock"></i> Pending <span class="tab-badge pending">{{ count_pending }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ tab_approved }}" class="nav-link {% if active_tab == 'approved' %}active{% endif %}">
                    <i class="fas fa-regular fa-circle-check"></i> Approved <span class="tab-badge approved">{{ count_approved }}</span>
                </a>
            </li>
            <li class="nav-item">
                <a href="{{ tab_rejected }}" class="nav-link {% if active_tab == 'rejected' %}active{% endif %}">
                    <i class="fas fa-regular fa-circle-xmark"></i> Rejected <span class="tab-badge rejected">{{ count_rejected }}</span>
                </a>
            </li>
        </ul>
        
        <!-- Filter Bar -->
        <div class="filter-bar mt-3">
            <form action="{{ action }}" method="get">
                <div class="row g-3">
                    <input type="hidden" name="route" value="pms/payment_requests">
                    <input type="hidden" name="user_token" value="{{ user_token }}">
                    <input type="hidden" name="tab" value="{{ active_tab }}">
                    
                    <div class="col-md-2">
                        <input type="text" name="filter_project" class="form-control" placeholder="Project" value="{{ filter_project }}">
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="filter_bkash_number" class="form-control" placeholder="bKash Number" value="{{ filter_bkash_number }}">
                    </div>
                    <div class="col-md-2">
                        <input type="text" name="filter_transaction_id" class="form-control" placeholder="Transaction ID" value="{{ filter_transaction_id }}">
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="filter_amount_min" class="form-control" placeholder="Min" value="{{ filter_amount_min }}">
                    </div>
                    <div class="col-md-1">
                        <input type="number" name="filter_amount_max" class="form-control" placeholder="Max" value="{{ filter_amount_max }}">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-solid fa-search"></i> Filter
                        </button>
                    </div>
                </div>
            </form>
        </div>
        
        <!-- Bulk Actions -->
        <div class="bulk-bar" id="bulk-bar">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="bulk-info">
                    <i class="fas fa-regular fa-circle-check text-warning"></i>
                    <span id="selected-count" class="fw-bold">0</span>
                    <span class="text-muted">requests selected</span>
                </div>
                <div class="bulk-controls">
                    <select id="bulk-action" class="form-select form-select-sm">
                        <option value="">Bulk Action</option>
                        <option value="approve">Approve</option>
                        <option value="reject">Reject</option>
                        <option value="delete">Delete</option>
                    </select>
                    <button type="button" id="bulk-apply" class="btn btn-primary btn-sm">
                        <i class="fas fa-regular fa-check"></i> Apply
                    </button>
                    <button type="button" id="clear-selection" class="btn btn-secondary btn-sm">
                        <i class="fas fa-regular fa-xmark"></i> Clear
                    </button>
                </div>
            </div>
        </div>
        
        <!-- Requests Table -->
        <div class="card">
            <div class="card-header">
                <i class="fas fa-solid fa-list"></i> Payment Requests
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th style="width: 1px;"><input type="checkbox" id="select-all"></th>
                                <th>Project</th>
                                <th>Duration</th>
                                <th>Amount</th>
                                <th>bKash Number</th>
                                <th>Transaction ID</th>
                                <th>Status</th>
                                <th>Submitted By</th>
                                <th>Submitted At</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if requests %}
                                {% for request in requests %}
                                    <tr>
                                        <td>
                                            {% if request.status == 'pending' %}
                                                <input type="checkbox" class="request-selector" value="{{ request.request_id }}">
                                            {% endif %}
                                        </td>
                                        <td><strong>{{ request.project_name }}</strong></a>
                                        <td>{{ request.duration_months }} mo</a>
                                        <td class="amount-text">৳ {{ request.amount|number_format(2) }}</a>
                                        <td>{{ request.bkash_number }}</a>
                                        <td><span class="transaction-id">{{ request.transaction_id }}</span></a>
                                        <td>
                                            <span class="status-badge status-{{ request.status }}">
                                                {{ request.status_text|upper }}
                                            </span>
                                        </a>
                                        <td>{{ request.submitted_by }}</a>
                                        <td>{{ request.submitted_at }}</a>
                                        <td class="text-end">
                                            <div class="action-buttons">
                                                {% if request.status == 'pending' %}
                                                    <button type="button" class="btn btn-success btn-sm" onclick="approveRequest({{ request.request_id }})" title="Approve">
                                                        <i class="fas fa-regular fa-circle-check"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-danger btn-sm" onclick="showRejectModal({{ request.request_id }})" title="Reject">
                                                        <i class="fas fa-regular fa-circle-xmark"></i>
                                                    </button>
                                                {% elseif request.status == 'approved' %}
                                                    <span class="text-success fw-bold">
                                                        <i class="fas fa-regular fa-circle-check"></i> Approved
                                                    </span>
                                                {% elseif request.status == 'rejected' %}
                                                    <span class="text-danger fw-bold">
                                                        <i class="fas fa-regular fa-circle-xmark"></i> Rejected
                                                    </span>
                                                {% endif %}
                                            </div>
                                        </a>
                                    </tr>
                                {% endfor %}
                            {% else %}
                                <tr>
                                    <td colspan="10" class="text-center text-muted py-4">
                                        <i class="fas fa-regular fa-inbox fa-2x mb-2 d-block"></i>
                                        No payment requests found
                                    </a>
                                </tr>
                            {% endif %}
                        </tbody>
                    </table>
                </div>
                <div class="row">
                    <div class="col-sm-6 text-start">{{ pagination }}</div>
                    <div class="col-sm-6 text-end">{{ results }}</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade modal-confirm" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-regular fa-circle-xmark"></i> Reject Payment Request
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="fas fa-regular fa-triangle-exclamation"></i>
                    <strong>Are you sure?</strong><br>
                    This action will reject the payment request and the subscription will not be activated.
                </div>
                <div class="mb-3">
                    <label class="form-label">Reason for Rejection <span class="text-muted">(Optional)</span></label>
                    <textarea id="reject-reason" class="form-control" rows="3" placeholder="Enter reason for rejection..."></textarea>
                </div>
                <div id="reject-request-info" class="alert alert-info small">
                    <strong>Request Details:</strong><br>
                    <span id="reject-project"></span> | 
                    Transaction: <span id="reject-transaction"></span> | 
                    Amount: <span id="reject-amount"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirm-reject">
                    <i class="fas fa-regular fa-circle-xmark"></i> Confirm Reject
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Approve Confirmation Modal -->
<div class="modal fade modal-confirm" id="approveModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%);">
                <h5 class="modal-title">
                    <i class="fas fa-regular fa-circle-check"></i> Approve Payment Request
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-success">
                    <i class="fas fa-regular fa-circle-check"></i>
                    <strong>Confirm Approval</strong><br>
                    This will activate the subscription for the project immediately.
                </div>
                <div id="approve-request-info" class="alert alert-info small">
                    <strong>Request Details:</strong><br>
                    <span id="approve-project"></span> | 
                    Transaction: <span id="approve-transaction"></span> | 
                    Amount: <span id="approve-amount"></span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-success" id="confirm-approve">
                    <i class="fas fa-regular fa-circle-check"></i> Confirm Approve
                </button>
            </div>
        </div>
    </div>
</div>

<script>
var currentRequestId = 0;
var currentRequestData = {};

// Select All
$('#select-all').on('change', function() {
    $('.request-selector').prop('checked', $(this).prop('checked'));
    updateSelectedCount();
});

$('.request-selector').on('change', function() {
    updateSelectedCount();
});

function updateSelectedCount() {
    var count = $('.request-selector:checked').length;
    $('#selected-count').text(count);
    if (count > 0) {
        $('#bulk-bar').show();
    } else {
        $('#bulk-bar').hide();
    }
}

// Bulk Apply
$('#bulk-apply').on('click', function() {
    var action = $('#bulk-action').val();
    var selected = [];
    $('.request-selector:checked').each(function() {
        selected.push($(this).val());
    });
    
    if (!action) {
        alert('Please select an action');
        return;
    }
    
    if (selected.length === 0) {
        alert('Please select at least one request');
        return;
    }
    
    if (confirm('Apply "' + action + '" to ' + selected.length + ' request(s)?')) {
        $.ajax({
            url: '{{ action }}',
            type: 'POST',
            data: {
                selected: selected,
                action: action,
                user_token: '{{ user_token }}'
            },
            dataType: 'json',
            success: function(json) {
                if (json.success) {
                    location.reload();
                } else {
                    alert(json.error);
                }
            }
        });
    }
});

$('#clear-selection').on('click', function() {
    $('.request-selector').prop('checked', false);
    $('#select-all').prop('checked', false);
    updateSelectedCount();
});

// Approve Request
function approveRequest(requestId) {
    // Get request details
    $.ajax({
        url: 'index.php?route=pms/payment_requests.getStatus&user_token={{ user_token }}&request_id=' + requestId,
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            if (data.success) {
                currentRequestId = requestId;
                // Find the request in the table
                var row = $('tr:has(button[onclick*="approveRequest(' + requestId + ')"])');
                var project = row.find('td:eq(1)').text().trim();
                var transaction = row.find('td:eq(5)').text().trim();
                var amount = row.find('td:eq(3)').text().trim();
                
                $('#approve-project').text(project);
                $('#approve-transaction').text(transaction);
                $('#approve-amount').text(amount);
                
                $('#approveModal').modal('show');
            }
        }
    });
}

$('#confirm-approve').on('click', function() {
    $('#confirm-approve').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Processing...');
    
    $.ajax({
        url: 'index.php?route=pms/payment_requests.approve&user_token={{ user_token }}&request_id=' + currentRequestId,
        type: 'GET',
        dataType: 'json',
        success: function(json) {
            if (json.success) {
                $('#approveModal').modal('hide');
                location.reload();
            } else {
                alert(json.error);
                $('#confirm-approve').prop('disabled', false).html('<i class="fas fa-regular fa-circle-check"></i> Confirm Approve');
            }
        }
    });
});

// Reject Request
function showRejectModal(requestId) {
    // Get request details
    $.ajax({
        url: 'index.php?route=pms/payment_requests.getStatus&user_token={{ user_token }}&request_id=' + requestId,
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            if (data.success) {
                currentRequestId = requestId;
                var row = $('tr:has(button[onclick*="showRejectModal(' + requestId + ')"])');
                var project = row.find('td:eq(1)').text().trim();
                var transaction = row.find('td:eq(5)').text().trim();
                var amount = row.find('td:eq(3)').text().trim();
                
                $('#reject-project').text(project);
                $('#reject-transaction').text(transaction);
                $('#reject-amount').text(amount);
                
                $('#rejectModal').modal('show');
            }
        }
    });
}

$('#confirm-reject').on('click', function() {
    var reason = $('#reject-reason').val();
    
    $('#confirm-reject').prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Processing...');
    
    $.ajax({
        url: 'index.php?route=pms/payment_requests.reject&user_token={{ user_token }}&request_id=' + currentRequestId,
        type: 'POST',
        data: {
            reason: reason,
            user_token: '{{ user_token }}'
        },
        dataType: 'json',
        success: function(json) {
            if (json.success) {
                $('#rejectModal').modal('hide');
                location.reload();
            } else {
                alert(json.error);
                $('#confirm-reject').prop('disabled', false).html('<i class="fas fa-regular fa-circle-xmark"></i> Confirm Reject');
            }
        }
    });
});

// Reset modal on close
$('#rejectModal, #approveModal').on('hidden.bs.modal', function() {
    $('#reject-reason').val('');
    $('#confirm-reject').prop('disabled', false).html('<i class="fas fa-regular fa-circle-xmark"></i> Confirm Reject');
    $('#confirm-approve').prop('disabled', false).html('<i class="fas fa-regular fa-circle-check"></i> Confirm Approve');
});
</script>

{{ footer }}