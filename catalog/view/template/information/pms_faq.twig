{{ top_menu }}

<style>
    .faq-container {
        max-width: 900px;
        margin: 0 auto;
        padding: 40px 20px;
    }
    .faq-header {
        text-align: center;
        margin-bottom: 40px;
    }
    .faq-header h1 {
        font-size: 36px;
        font-weight: 700;
        color: #0B3C5D;
        margin-bottom: 15px;
    }
    .faq-header p {
        font-size: 18px;
        color: #6B7280;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }
    .faq-section {
        margin-bottom: 40px;
    }
    .faq-section-title {
        font-size: 22px;
        font-weight: 700;
        color: #0B3C5D;
        margin-bottom: 20px;
        padding-bottom: 10px;
        border-bottom: 2px solid #e0e0e0;
    }
    .faq-section-title i {
        color: #1F8A4D;
        margin-right: 10px;
    }
    .faq-item {
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        margin-bottom: 12px;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .faq-item:hover {
        border-color: #1F8A4D;
    }
    .faq-item .faq-question {
        padding: 18px 20px;
        background: #f8f9fa;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 600;
        color: #0B3C5D;
        transition: background 0.3s ease;
        user-select: none;
    }
    .faq-item .faq-question:hover {
        background: #f0f0f0;
    }
    .faq-item .faq-question i.fa-chevron-down {
        transition: transform 0.3s ease;
        color: #1F8A4D;
    }
    .faq-item .faq-question i.fa-chevron-down.rotated {
        transform: rotate(180deg);
    }
    .faq-item .faq-answer {
        padding: 0 20px;
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.4s ease, padding 0.3s ease;
        color: #374151;
        line-height: 1.6;
        font-size: 14px;
    }
    .faq-item .faq-answer.open {
        max-height: 500px;
        padding: 20px 20px;
    }
    .faq-item .faq-answer p {
        margin: 0;
    }
    .faq-cta {
        text-align: center;
        margin-top: 40px;
        padding: 30px;
        background: #f8f9fa;
        border-radius: 12px;
    }
    .faq-cta h3 {
        margin-bottom: 10px;
        color: #0B3C5D;
    }
    .faq-cta p {
        color: #6B7280;
        margin-bottom: 15px;
    }
    .faq-cta .btn-contact {
        background: #1F8A4D;
        color: white;
        padding: 10px 30px;
        border-radius: 50px;
        text-decoration: none;
        font-weight: 600;
        transition: all 0.3s ease;
        display: inline-block;
    }
    .faq-cta .btn-contact:hover {
        background: #166d3e;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(31, 138, 77, 0.3);
    }
    @media (max-width: 576px) {
        .faq-header h1 {
            font-size: 28px;
        }
        .faq-item .faq-question {
            font-size: 14px;
        }
    }
</style>

<div class="container-fluid faq-container">
    <div class="faq-header">
        <h1>{{ heading_title }}</h1>
        <p>{{ text_faq_description }}</p>
    </div>

    {% for section in faqs %}
        <div class="faq-section">
            <div class="faq-section-title">
                <i class="fas fa-regular {{ section.title == 'General Questions' ? 'fa-circle-question' : section.title == 'Subscription & Pricing' ? 'fa-credit-card' : section.title == 'Features & Usage' ? 'fa-star' : 'fa-shield' }}"></i>
                {{ section.title }}
            </div>

            {% for item in section.items %}
                <div class="faq-item">
                    <div class="faq-question" onclick="toggleFaq(this)">
                        <span>{{ item.question }}</span>
                        <i class="fas fa-solid fa-chevron-down"></i>
                    </div>
                    <div class="faq-answer">
                        <p>{{ item.answer }}</p>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endfor %}

    <div class="faq-cta">
        <h3><i class="fas fa-regular fa-envelope"></i> Still have questions?</h3>
        <p>Our team is here to help you. Contact us and we'll get back to you shortly.</p>
        <a href="{{ contact }}" class="btn-contact">
            <i class="fas fa-regular fa-envelope"></i> Contact Us
        </a>
    </div>
</div>

<script>
function toggleFaq(element) {
    var answer = element.nextElementSibling;
    var icon = element.querySelector('i.fa-chevron-down');

    // Close all other FAQs
    var allAnswers = document.querySelectorAll('.faq-answer');
    var allIcons = document.querySelectorAll('.faq-question i.fa-chevron-down');
    allAnswers.forEach(function(a) {
        if (a !== answer && a.classList.contains('open')) {
            a.classList.remove('open');
        }
    });
    allIcons.forEach(function(i) {
        if (i !== icon && i.classList.contains('rotated')) {
            i.classList.remove('rotated');
        }
    });

    // Toggle current
    answer.classList.toggle('open');
    icon.classList.toggle('rotated');
}
</script>

{{ footer }}