<style>
    .contact-container {
        max-width: 1000px;
        margin: 0 auto;
        padding: 40px 20px;
    }
    .contact-header {
        text-align: center;
        margin-bottom: 40px;
    }
    .contact-header h1 {
        font-size: 36px;
        font-weight: 700;
        color: #0B3C5D;
        margin-bottom: 15px;
    }
    .contact-header p {
        font-size: 18px;
        color: #6B7280;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }
    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }
    .contact-info {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 30px;
    }
    .contact-info h3 {
        font-size: 20px;
        color: #0B3C5D;
        margin-bottom: 20px;
    }
    .contact-info .info-item {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 15px;
        padding: 10px 0;
        border-bottom: 1px solid #e0e0e0;
    }
    .contact-info .info-item:last-child {
        border-bottom: none;
        margin-bottom: 0;
    }
    .contact-info .info-item i {
        width: 40px;
        height: 40px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1F8A4D;
        font-size: 18px;
    }
    .contact-info .info-item .label {
        font-weight: 600;
        color: #374151;
        font-size: 13px;
    }
    .contact-info .info-item .value {
        color: #6B7280;
        font-size: 13px;
    }
    .contact-form {
        background: white;
        border-radius: 12px;
        padding: 30px;
        border: 1px solid #e0e0e0;
    }
    .contact-form h3 {
        font-size: 20px;
        color: #0B3C5D;
        margin-bottom: 20px;
    }
    .contact-form .form-group {
        margin-bottom: 18px;
    }
    .contact-form .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 5px;
        color: #333;
        font-size: 13px;
    }
    .contact-form .form-group .required {
        color: #dc3545;
    }
    .contact-form .form-control {
        width: 100%;
        padding: 10px 12px;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 14px;
        transition: border-color 0.2s;
    }
    .contact-form .form-control:focus {
        outline: none;
        border-color: #1F8A4D;
        box-shadow: 0 0 0 3px rgba(31, 138, 77, 0.1);
    }
    .contact-form .btn-submit {
        padding: 12px 30px;
        background: #1F8A4D;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s;
        width: 100%;
    }
    .contact-form .btn-submit:hover {
        background: #166d3e;
    }
    .alert-success {
        background: #d4edda;
        color: #155724;
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
        border: 1px solid #c3e6cb;
    }
    @media (max-width: 768px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }
        .contact-header h1 {
            font-size: 28px;
        }
    }
</style>

<div class="container-fluid contact-container">
    <div class="contact-header">
        <h1>{{ heading_title }}</h1>
        <p>{{ text_contact_description }}</p>
    </div>

    <div class="contact-grid">
        <!-- Contact Info -->
        <div class="contact-info">
            <h3><i class="fas fa-regular fa-circle-info"></i> Get in Touch</h3>
            <div class="info-item">
                <i class="fas fa-regular fa-location-dot"></i>
                <div>
                    <div class="label">Address</div>
                    <div class="value">{{ address }}</div>
                </div>
            </div>
            <div class="info-item">
                <i class="fas fa-regular fa-envelope"></i>
                <div>
                    <div class="label">Email</div>
                    <div class="value"><a href="mailto:{{ email }}">{{ email }}</a></div>
                </div>
            </div>
            <div class="info-item">
                <i class="fas fa-regular fa-phone"></i>
                <div>
                    <div class="label">Phone</div>
                    <div class="value"><a href="tel:{{ telephone }}">{{ telephone }}</a></div>
                </div>
            </div>
            {% if fax %}
            <div class="info-item">
                <i class="fas fa-regular fa-fax"></i>
                <div>
                    <div class="label">Fax</div>
                    <div class="value">{{ fax }}</div>
                </div>
            </div>
            {% endif %}
            <div class="info-item">
                <i class="fas fa-regular fa-clock"></i>
                <div>
                    <div class="label">Working Hours</div>
                    <div class="value">Sunday - Thursday: 9:00 AM - 6:00 PM</div>
                </div>
            </div>
        </div>

        <!-- Contact Form -->
        <div class="contact-form">
            <h3><i class="fas fa-regular fa-envelope"></i> Send Us a Message</h3>

            {% if success %}
                <div class="alert-success">{{ success }}</div>
            {% endif %}

            <form action="{{ action }}" method="post">
                <div class="form-group">
                    <label for="input-name">Your Name <span class="required">*</span></label>
                    <input type="text" name="name" id="input-name" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="input-email">Email Address <span class="required">*</span></label>
                    <input type="email" name="email" id="input-email" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="input-subject">Subject <span class="required">*</span></label>
                    <input type="text" name="subject" id="input-subject" class="form-control" required>
                </div>
                <div class="form-group">
                    <label for="input-message">Message <span class="required">*</span></label>
                    <textarea name="message" id="input-message" class="form-control" rows="5" required></textarea>
                </div>
                <button type="submit" name="submit" class="btn-submit">
                    <i class="fas fa-regular fa-paper-plane"></i> Send Message
                </button>
            </form>
        </div>
    </div>
</div>

{{ footer }}