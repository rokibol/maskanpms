<div id="mobile_top_bar" class="d-flex d-md-none align-items-center justify-content-center text-center pms-welcome-hero" style="height: 60px; color: #FFFFFF; margin-bottom: 10px;">
  <p class="m-0" style="font-size: 20px;">{{ project_name }}</p>
</div>
{# ======================================================
   SUBSCRIPTION EXPIRY WARNING
   ====================================================== #}
{% if subscription_warning %}
    <div class="subscription-expiry-warning alert alert-warning alert-dismissible fade show" role="alert" style="border-left: 4px solid #F59E0B; background: #FFFBEB; border-radius: 8px; padding: 15px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 15px;">
            <div style="font-size: 28px; color: #F59E0B;">
                <i class="fa-regular fa-clock"></i>
            </div>
            <div>
                <strong style="color: #92400E; font-size: 15px;">
                    ⚠️ Your subscription is expiring soon!
                </strong>
                <p style="margin: 4px 0 0 0; color: #78350F; font-size: 14px;">
                    Your subscription will expire in <strong style="color: #DC2626; font-size: 16px;">{{ subscription_expiry_days }}</strong> day(s) on <strong>{{ subscription_end_date }}</strong>.
                    Please renew your subscription to continue using the service without interruption.
                </p>
            </div>
        </div>
        <div style="margin-top: 10px;">
            <a href="{{ subscription_renew_link|default('index.php?route=account/pms_subscription') }}" class="btn btn-warning btn-sm" style="background: #F59E0B; border: none; color: white; font-weight: 600; padding: 8px 20px; border-radius: 6px;margin-right:40px;">
                <i class="fa-regular fa-credit-card"></i> Renew Now
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close" style="margin-left: 10px;top:20px;"></button>
        </div>
    </div>
{% endif %}

{# ======================================================
   ADMIN OVERRIDE ACTIVE BANNER
   ====================================================== #}
{% if subscription_has_override and subscription_warning == false %}
    <div class="subscription-override-banner alert alert-info alert-dismissible fade show" role="alert" style="border-left: 4px solid #3B82F6; background: #EFF6FF; border-radius: 8px; padding: 15px 20px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap;">
        <div style="display: flex; align-items: center; gap: 15px;">
            <div style="font-size: 28px; color: #3B82F6;">
                <i class="fa-regular fa-shield-haltered"></i>
            </div>
            <div>
                <strong style="color: #1E40AF; font-size: 15px;">
                    🔒 Admin Override Active
                </strong>
                <p style="margin: 4px 0 0 0; color: #1E3A5F; font-size: 14px;">
                    Your subscription has been manually extended by the administrator.
                    Expires on: <strong>{{ subscription_end_date }}</strong>
                </p>
            </div>
        </div>
        <div style="margin-top: 10px;">
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    </div>
{% endif %}

