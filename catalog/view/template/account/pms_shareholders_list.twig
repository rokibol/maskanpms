{{ header }}

<style>
    .shareholder-status {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .status-active { background: #e8f5e9; color: #2e7d32; }
    .status-inactive { background: #fff3e0; color: #e65100; }
    .status-suspended { background: #ffebee; color: #c62828; }
    .status-enabled { background: #e8f5e9; color: #2e7d32; }
    .status-disabled { background: #ffebee; color: #c62828; }
    .filter-bar {
        background: #f5f5f5;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .bulk-action-bar {
        background: #fff;
        padding: 10px 15px;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Global fix for dropdowns in tables */
    .table-responsive {
        overflow-x: auto;
        overflow: visible !important;
    }

    .table {
        overflow: visible !important;
    }

    .table td {
        overflow: visible !important;
    }

    .table .dropdown,
    .table .btn-group {
        position: static !important;
    }

    .table .dropdown-menu {
        position: absolute !important;
        z-index: 9999 !important;
        inset: auto auto 0 auto !important;
    }

    .dropdown-menu { position: absolute !important; z-index: 9999 !important; }

    /* For right-aligned dropdowns */
    .table .dropdown-menu-end {
        right: 0 !important;
        left: auto !important;
    }

    /* On hover, ensure dropdown is above */
    .table tr:hover {
        overflow: visible !important;
    }

    /* Fix for card body clipping */
    .card-body {
        overflow: visible !important;
    }

    /* Fix for content area */
    #content {
        overflow: visible !important;
    }
</style>

<div class="container-fluid">
    {#<ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
            <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>#}
    
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ heading_title }}</h1>
                <div>
                    <a href="{{ bulk_allocation_rate }}" class="btn btn-info">
                        <i class="fa-solid fa-calculator"></i> Bulk Allocation by Rate
                    </a>
                    <a href="{{ add }}" class="btn btn-primary">
                        <i class="fa-solid fa-plus"></i> {{ button_add }}
                    </a>
                    <a href="{{ back }}" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
            
            <!-- Filter Bar -->
            <div class="filter-bar">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" name="filter_search" value="{{ filter_search }}" class="form-control" placeholder="Search by name, email or code">
                    </div>
                    <div class="col-md-3">
                        <select name="filter_status" class="form-select">
                            <option value="">All Status</option>
                            {% for status_value, status_name in statuses %}
                                <option value="{{ status_value }}" {{ filter_status == status_value ? 'selected' : '' }}>{{ status_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="filter_user_status" class="form-select">
                            <option value="">All Login Status</option>
                            {% for status_value, status_name in user_statuses %}
                                <option value="{{ status_value }}" {{ filter_user_status == status_value ? 'selected' : '' }}>{{ status_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="button-filter" class="btn btn-primary w-100">
                            <i class="fas fa-solid fa-search"></i> Filter
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Bulk Action Bar -->
            <div class="bulk-action-bar">
                <input type="checkbox" id="select-all" class="form-check-input me-2">
                <span class="me-2"><strong>Selected:</strong></span>
                <select id="bulk-action" class="form-select w-auto">
                    <option value="">{{ text_select_action }}</option>
                    <option value="activate">{{ text_activate }}</option>
                    <option value="deactivate">{{ text_deactivate }}</option>
                    <option value="suspend">{{ text_suspend }}</option>
                    <option value="delete">{{ text_delete }}</option>
                </select>
                <button type="button" id="button-bulk-action" class="btn btn-secondary">Apply</button>
                <span class="text-muted ms-auto small">Showing {{ results }}</span>
            </div>
            
            <!-- Shareholder Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="width: 1px;"><input type="checkbox" id="select-all-header"></th>
                            <th><a href="{{ sort_name }}">Name</a></th>
                            <th>Code</th>
                            <th><a href="{{ sort_email }}">Email</a></th>
                            <th>Phone</th>
                            <th><a href="{{ sort_units }}">Units</a></th>
                            <th><a href="{{ sort_percentage }}">Percentage</a></th>
                            <th>Due</th>
                            <th><a href="{{ sort_status }}">Status</a></th>
                            <th>Login</th>
                            <th><a href="{{ sort_date }}">Registered</a></th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if shareholders %}
                            {% for shareholder in shareholders %}
                                <tr>
                                    <td><input type="checkbox" name="selected[]" value="{{ shareholder.shareholder_id }}" class="row-selector"></td>
                                    <td>{{ shareholder.name }}</td>
                                    <td>{{ shareholder.shareholder_code }}</td>
                                    <td>{{ shareholder.email }}</td>
                                    <td>{{ shareholder.phone }}</td>
                                    <td>{{ shareholder.ownership_units }}</td>
                                    <td>{{ shareholder.ownership_percentage }}%</td>
                                    <td class="text-danger">৳ {{ shareholder.due_amount|number_format(2) }}</td>
                                    <td>
                                        <span class="shareholder-status status-{{ shareholder.status }}">
                                            {{ shareholder.status|capitalize }}
                                        </span>
                                    </td>
                                    <td>
                                        <span class="shareholder-status status-{{ shareholder.user_status_text|lower }}">
                                            {{ shareholder.user_status_text }}
                                        </span>
                                    </td>
                                    <td>{{ shareholder.registered_date }}</td>
                                    <td class="text-end" style="position: relative; overflow: visible;">
                                        <div class="dropdown action-dropdown" style="position: relative; display: inline-block;">
                                            <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-solid fa-gear"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end" style="position: absolute; z-index: 9999; min-width: 160px;">
                                                <li>
                                                    <a class="dropdown-item" href="{{ shareholder.view }}">
                                                        <i class="fas fa-regular fa-eye"></i> View
                                                    </a>
                                                </li>
                                                <li>
                                                    <a class="dropdown-item" href="{{ shareholder.edit }}">
                                                        <i class="fas fa-regular fa-pen-to-square"></i> Edit
                                                    </a>
                                                </li>
                                                
                                                <li>
                                                    <a class="dropdown-item" href="{{ shareholder.payment_allocation }}">
                                                        <i class="fas fa-solid fa-credit-card"></i> Payment Allocation
                                                    </a>
                                                </li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li>
                                                    <a class="dropdown-item text-danger" href="javascript:void(0);" onclick="deleteShareholder({{ shareholder.shareholder_id }})">
                                                        <i class="fas fa-regular fa-trash-can"></i> Delete
                                                    </a>
                                                </li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="12" class="text-center text-muted py-4">
                                    <i class="fas fa-regular fa-users fa-2x mb-2 d-block"></i>
                                    {{ text_no_results }}
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            
            <div class="row">
                <div class="col-sm-6 text-start">{{ pagination }}</div>
                <div class="col-sm-6 text-end">{{ results }}</div>
            </div>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

<script>
// Filter
$('#button-filter').on('click', function() {
    var url = 'index.php?route=account/pms_shareholders&language={{ language }}';
    
    var filter_search = $('input[name=\'filter_search\']').val();
    if (filter_search) {
        url += '&filter_search=' + encodeURIComponent(filter_search);
    }
    
    var filter_status = $('select[name=\'filter_status\']').val();
    if (filter_status) {
        url += '&filter_status=' + encodeURIComponent(filter_status);
    }
    
    var filter_user_status = $('select[name=\'filter_user_status\']').val();
    if (filter_user_status) {
        url += '&filter_user_status=' + encodeURIComponent(filter_user_status);
    }
    
    location = url;
});

// Enter key in search
$('input[name=\'filter_search\']').keydown(function(e) {
    if (e.keyCode == 13) {
        $('#button-filter').click();
    }
});

// Select All
$('#select-all, #select-all-header').on('change', function() {
    var isChecked = $(this).prop('checked');
    $('.row-selector').prop('checked', isChecked);
});

// Bulk Action
$('#button-bulk-action').on('click', function() {
    var action = $('#bulk-action').val();
    var selected = [];
    
    $('.row-selector:checked').each(function() {
        selected.push($(this).val());
    });
    
    if (!action) {
        alert('Please select an action');
        return;
    }
    
    if (selected.length === 0) {
        alert('Please select at least one shareholder');
        return;
    }
    
    if (action === 'delete') {
        if (!confirm('Are you sure you want to delete selected shareholders? This action cannot be undone.')) {
            return;
        }
    } else {
        if (!confirm('Are you sure you want to ' + action + ' selected shareholders?')) {
            return;
        }
    }
    
    $.ajax({
        url: '{{ bulk_action_url }}',
        type: 'POST',
        data: {
            action: action,
            selected: selected,
            user_token: '{{ user_token }}'
        },
        dataType: 'json',
        success: function(json) {
            if (json.success) {
                location.reload();
            } else {
                alert(json.error);
            }
        }
    });
});

// Delete single shareholder
function deleteShareholder(shareholder_id) {
    if (confirm('Are you sure you want to delete this shareholder?')) {
        $.ajax({
            url: 'index.php?route=account/pms_shareholders.delete&language={{ language }}&shareholder_id=' + shareholder_id + '&customer_token={{ customer_token }}',
            type: 'POST',
            dataType: 'json',
            success: function(json) {
                if (json.success) {
                    location.reload();
                } else {
                    alert(json.error);
                }
            }
        });
    }
}

// Fix dropdown positioning
$(document).ready(function() {
    // Recalculate dropdown position when opened
    $('.dropdown-toggle').on('show.bs.dropdown', function() {
        var $dropdown = $(this).closest('.dropdown');
        var $menu = $dropdown.find('.dropdown-menu');
        var buttonOffset = $(this).offset();
        var buttonHeight = $(this).outerHeight();
        
        // Check if dropdown would go outside viewport
        var menuHeight = $menu.outerHeight();
        var viewportBottom = $(window).scrollTop() + $(window).height();
        var buttonBottom = buttonOffset.top + buttonHeight;
        
        if (buttonBottom + menuHeight > viewportBottom) {
            // Show above if not enough space below
            $menu.css({
                'top': 'auto',
                'bottom': '100%',
                'right': '0',
                'left': 'auto'
            });
        } else {
            // Show below
            $menu.css({
                'top': '100%',
                'bottom': 'auto',
                'right': '0',
                'left': 'auto'
            });
        }
    });
    
    // Reset dropdown position when hidden
    $('.dropdown').on('hidden.bs.dropdown', function() {
        $(this).find('.dropdown-menu').removeAttr('style');
    });
});
</script>

{{ footer }}