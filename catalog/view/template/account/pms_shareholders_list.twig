{{ header }}

<style>
    .shareholder-status {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .status-active { background: #e8f5e9; color: #2e7d32; }
    .status-inactive { background: #fff3e0; color: #e65100; }
    .status-suspended { background: #ffebee; color: #c62828; }
    .status-enabled { background: #e8f5e9; color: #2e7d32; }
    .status-disabled { background: #ffebee; color: #c62828; }
    .filter-bar {
        background: #f5f5f5;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .bulk-action-bar {
        background: #fff;
        padding: 10px 15px;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        margin-bottom: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    /* Enable horizontal scroll on mobile — do NOT use overflow: visible */
    .table-responsive {
        overflow-x: auto !important;
        overflow-y: visible !important;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
    }
    .table-responsive > .table {
        min-width: 1000px;
    }

    .table td {
        overflow: visible !important;
    }

    .table .dropdown,
    .table .btn-group {
        position: static !important;
    }

    .table .dropdown-menu {
        position: absolute !important;
        z-index: 9999 !important;
        inset: auto auto 0 auto !important;
    }

    .dropdown-menu { position: absolute !important; z-index: 9999 !important; }

    .table .dropdown-menu-end {
        right: 0 !important;
        left: auto !important;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>

        <div id="content" class="col">
            {{ content_top }}

            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                <h1>{{ heading_title }}</h1>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="{{ add }}" class="btn btn-primary">
                        <i class="fa-solid fa-plus"></i> {{ button_add }}
                    </a>
                    <button type="button" class="btn btn-success"
                            id="sharePopover"
                            data-bs-container="body"
                            data-bs-toggle="popover"
                            data-bs-placement="bottom"
                            data-bs-html="true"
                            title="Share Registration Link">
                        <i class="fa-solid fa-share-nodes"></i> Share
                    </button>
                    <a href="{{ back }}" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>

            <!-- Filter Bar -->
            <div class="filter-bar">
                <div class="row g-3">
                    <div class="col-md-4">
                        <input type="text" name="filter_search" value="{{ filter_search }}" class="form-control" placeholder="Search by name, email or code">
                    </div>
                    <div class="col-md-3">
                        <select name="filter_status" class="form-select">
                            <option value="">All Status</option>
                            {% for status_value, status_name in statuses %}
                                <option value="{{ status_value }}">{{ status_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select name="filter_user_status" class="form-select">
                            <option value="">All Login Status</option>
                            {% for status_value, status_name in user_statuses %}
                                <option value="{{ status_value }}">{{ status_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="button-filter" class="btn btn-primary w-100">
                            <i class="fas fa-solid fa-search"></i> Filter
                        </button>
                    </div>
                </div>
            </div>

            <!-- Bulk Action Bar -->
            <div class="bulk-action-bar" id="bulk-action-container">
                <input type="checkbox" id="select-all" class="form-check-input me-2">
                <span class="me-2"><strong>Selected:</strong></span>
                <select id="bulk-action" class="form-select w-auto">
                    <option value="">{{ text_select_action }}</option>
                    <option value="activate">{{ text_activate }}</option>
                    <option value="deactivate">{{ text_deactivate }}</option>
                    <option value="suspend">{{ text_suspend }}</option>
                    <option value="delete">{{ text_delete }}</option>
                </select>
                <button type="button" id="button-bulk-action" class="btn btn-secondary">Apply</button>
            </div>

            <!-- Shareholder Table -->
            <div class="table-responsive" id="shareholder-table-container">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th style="width: 1px;"><input type="checkbox" id="select-all-header"></th>
                            <th><a href="{{ sort_name }}">Name</a></th>
                            <th>Code</th>
                            <th><a href="{{ sort_email }}">Email</a></th>
                            <th>Phone</th>
                            <th><a href="{{ sort_units }}">Units</a></th>
                            <th><a href="{{ sort_percentage }}">Percentage</a></th>
                            <th>Due</th>
                            <th><a href="{{ sort_status }}">Status</a></th>
                            <th>Login</th>
                            <th><a href="{{ sort_date }}">Registered</a></th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody id="shareholders-table-body">
                        <tr>
                            <td colspan="12" class="text-center text-muted py-4">
                                <i class="fas fa-search fa-2x mb-2 d-block"></i>
                                Use the filter above and click "Filter" to load shareholders.
                            </td>
                        </tr>
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="5">Total Units:</td>
                            <td id="total-allocated-units">—</td>
                            <td colspan="6"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <!-- Pagination (hidden until AJAX returns) -->
            <div class="row" id="shareholders-pagination-row" style="display: none;">
                <div class="col-sm-6 text-start" id="shareholders-pagination"></div>
                <div class="col-sm-6 text-end" id="shareholders-results"></div>
            </div>

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>

<!-- Popover Content Template -->
<template id="popover-content">
  <div class="p-2 share-panel-wrapper" style="min-width: 220px;">
    <div class="input-group input-group-sm mb-3">
      <input type="text" class="form-control text-muted" value="{{ shareholder_registration_url }}" readonly id="shareLinkInput">
      <button class="btn btn-primary" type="button" id="btnPopoverCopy" onclick="copyShareLink()">
        <i class="fa-regular fa-copy"></i>
      </button>
    </div>
    <div class="d-flex flex-column gap-2">
      <a href="https://whatsapp.com{{ shareholder_registration_url|url_encode }}" target="_blank" class="btn btn-sm btn-outline-success text-start">
        <i class="fa-brands fa-whatsapp me-2"></i> WhatsApp
      </a>
      <a href="https://facebook.com{{ shareholder_registration_url|url_encode }}&redirect_uri={{ shareholder_registration_url|url_encode }}" target="_blank" class="btn btn-sm btn-outline-primary text-start">
        <i class="fa-brands fa-facebook-messenger me-2"></i> Messenger
      </a>
      <a href="https://instagram.com" target="_blank" class="btn btn-sm btn-outline-danger text-start" onclick="alert('Instagram does not support direct link passing via URLs. Link copied to clipboard!'); copyShareLink();">
        <i class="fa-brands fa-instagram me-2"></i> Instagram
      </a>
      <a href="mailto:?subject=Shareholder%20Registration&body=Please%20use%20this%20link%20to%20register%3A%20{{ shareholder_registration_url|url_encode }}" class="btn btn-sm btn-outline-secondary text-start">
        <i class="fa-regular fa-envelope me-2"></i> Email Link
      </a>
    </div>
  </div>
</template>

<script>
$(document).ready(function() {
    $("#shareholder-table-container").hide();
    $("#bulk-action-container").hide();
    // ---- Popover / Native Share logic ---- //
    var popoverTriggerEl = document.getElementById('sharePopover');
    var templateEl = document.getElementById('popover-content');

    var shareData = {
        title: 'Shareholder Registration',
        text: 'Please use this link to register as a shareholder:',
        url: '{{ shareholder_registration_url }}'
    };

    if (popoverTriggerEl && templateEl) {
        if (navigator.share) {
            popoverTriggerEl.removeAttribute('data-bs-toggle');
            popoverTriggerEl.removeAttribute('data-bs-target');
            popoverTriggerEl.addEventListener('click', function(e) {
                e.preventDefault();
                navigator.share(shareData).catch(function(){});
            });
        } else {
            var popover = new bootstrap.Popover(popoverTriggerEl, {
                content: templateEl.innerHTML,
                sanitize: false
            });
            $('body').on('click', function (e) {
                if (!$(popoverTriggerEl).is(e.target) && $(popoverTriggerEl).has(e.target).length === 0 && $('.popover').has(e.target).length === 0) {
                    popover.hide();
                }
            });
        }
    }

    // ---- AJAX load ---- //
    function loadShareholders(page) {
        page = page || 1;
        var query = 'index.php?route=account/pms_shareholders.loadList'
                  + '&language={{ language }}'
                  + '&customer_token={{ customer_token }}'
                  + '&page=' + page;

        var filter_search      = $('input[name="filter_search"]').val();
        var filter_status      = $('select[name="filter_status"]').val();
        var filter_user_status = $('select[name="filter_user_status"]').val();

        if (filter_search)      query += '&filter_search=' + encodeURIComponent(filter_search);
        if (filter_status)      query += '&filter_status=' + filter_status;
        if (filter_user_status) query += '&filter_user_status=' + filter_user_status;

        $('#shareholders-table-body').html(
            '<tr><td colspan="12" class="text-center py-4">' +
                '<i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br>' +
                '<span class="text-muted">Loading shareholders...</span>' +
            '</td></tr>'
        );
        $('#shareholders-pagination-row').hide();
        $("#shareholder-table-container").show();
        $("#bulk-action-container").show();

        $.ajax({
            url: query,
            type: 'GET',
            dataType: 'json',
            success: function(json) {
                $('#shareholders-table-body').html(json.rows);
                $('#shareholders-pagination').html(json.pagination);
                $('#shareholders-results').html(json.results);
                $('#total-allocated-units').html(json.total_allocated_units);
                $('#bulk-showing').text('Showing ' + (json.results || ''));

                if (json.total > 0) {
                    $('#shareholders-pagination-row').show();
                }

                // Reset bulk-action state
                $('#select-all, #select-all-header').prop('checked', false);

                bindPagination();
            },
            error: function() {
                $('#shareholders-table-body').html(
                    '<tr><td colspan="12" class="text-center text-danger py-4">' +
                        '<i class="fas fa-exclamation-circle"></i> Failed to load shareholders.' +
                    '</td></tr>'
                );
            }
        });
    }

    function bindPagination() {
        $('#shareholders-pagination a').off('click').on('click', function(e) {
            e.preventDefault();
            var href = $(this).attr('href');
            if (!href) return;
            var match = href.match(/[?&]page=(\d+)/);
            var page = match ? parseInt(match[1]) : 1;
            loadShareholders(page);
            $('html, body').animate({ scrollTop: $('#shareholders-table-body').offset().top - 120 }, 200);
        });
    }

    // Filter
    $('#button-filter').on('click', function() {
        loadShareholders(1);
    });

    $('input[name="filter_search"]').on('keydown', function(e) {
        if (e.keyCode == 13) { e.preventDefault(); $('#button-filter').click(); }
    });

    // Select All
    $(document).on('change', '#select-all, #select-all-header', function() {
        var isChecked = $(this).prop('checked');
        $('.row-selector').prop('checked', isChecked);
    });

    // Bulk action (unchanged behavior — reloads via AJAX on success)
    $('#button-bulk-action').on('click', function() {
        var action = $('#bulk-action').val();
        var selected = [];
        $('.row-selector:checked').each(function() { selected.push($(this).val()); });

        if (!action) { alert('Please select an action'); return; }
        if (selected.length === 0) { alert('Please select at least one shareholder'); return; }

        if (action === 'delete') {
            if (!confirm('Are you sure you want to delete selected shareholders? This action cannot be undone.')) return;
        } else {
            if (!confirm('Are you sure you want to ' + action + ' selected shareholders?')) return;
        }

        $.ajax({
            url: '{{ bulk_action_url }}',
            type: 'POST',
            data: { action: action, selected: selected, user_token: '{{ user_token }}' },
            dataType: 'json',
            success: function(json) {
                if (json.success) {
                    loadShareholders(1);
                } else {
                    alert(json.error || 'Failed to apply action.');
                }
            }
        });
    });

    // Delete single shareholder — global so AJAX-loaded rows can call it
    window.deleteShareholder = function(shareholder_id) {
        if (confirm('Are you sure you want to delete this shareholder?')) {
            $.ajax({
                url: 'index.php?route=account/pms_shareholders.delete&language={{ language }}&id=' + shareholder_id + '&customer_token={{ customer_token }}',
                type: 'POST',
                dataType: 'json',
                success: function(json) {
                    if (json.success) {
                        loadShareholders(1);
                    } else {
                        alert(json.error || 'Failed to delete shareholder.');
                    }
                }
            });
        }
    };

    // Fix dropdown positioning (unchanged)
    $(document).on('show.bs.dropdown', '.dropdown-toggle', function() {
        var $menu = $(this).closest('.dropdown').find('.dropdown-menu');
        var buttonOffset = $(this).offset();
        var buttonHeight = $(this).outerHeight();
        var menuHeight = $menu.outerHeight();
        var viewportBottom = $(window).scrollTop() + $(window).height();
        var buttonBottom = buttonOffset.top + buttonHeight;

        if (buttonBottom + menuHeight > viewportBottom) {
            $menu.css({ 'top': 'auto', 'bottom': '100%', 'right': '0', 'left': 'auto' });
        } else {
            $menu.css({ 'top': '100%', 'bottom': 'auto', 'right': '0', 'left': 'auto' });
        }
    });

    $(document).on('hidden.bs.dropdown', '.dropdown', function() {
        $(this).find('.dropdown-menu').removeAttr('style');
    });
});

// Copy link from popover
function copyShareLink() {
    var copyInput = document.querySelector('.popover #shareLinkInput');
    var copyButton = document.querySelector('.popover #btnPopoverCopy');

    if (copyInput) {
        copyInput.select();
        copyInput.setSelectionRange(0, 99999);
        navigator.clipboard.writeText(copyInput.value).then(function() {
            if (copyButton) {
                var originalHtml = copyButton.innerHTML;
                copyButton.innerHTML = '<i class="fa-solid fa-check"></i>';
                copyButton.className = "btn btn-success";
                setTimeout(function() {
                    copyButton.innerHTML = originalHtml;
                    copyButton.className = "btn btn-primary";
                }, 2000);
            }
        });
    }
}
</script>
{{ footer }}