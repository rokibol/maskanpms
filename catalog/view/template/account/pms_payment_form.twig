{{ header }}

<div class="container-fluid">
    {#<ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
            <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>#}
    
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ heading_add }}</h1>
                <div>
                    <button type="submit" form="form-payment" class="btn btn-primary">
                        <i class="fas fa-regular fa-floppy-disk"></i> {{ button_save }}
                    </button>
                    <a href="{{ back }}" class="btn btn-secondary">
                        <i class="fas fa-solid fa-reply"></i> {{ button_back }}
                    </a>
                </div>
            </div>
            
            <form id="form-payment" action="{{ action }}" method="post" data-oc-toggle="ajax">
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="fas fa-solid fa-credit-card"></i> Payment Information
                    </div>
                    <div class="card-body">
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Select Shareholder</label>
                            <div class="col-sm-9">
                                <select name="shareholder_id" class="form-select" required>
                                    <option value="">-- Select Shareholder --</option>
                                    {% for shareholder in shareholders %}
                                        <option value="{{ shareholder.id }}">
                                            {{ shareholder.firstname }} {{ shareholder.lastname }} ({{ shareholder.shareholder_code }}) - {{ shareholder.ownership_percentage|round(2) }}% ownership
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Payment Phase</label>
                            <div class="col-sm-9">
                                <select name="payment_phase_id" class="form-select" required>
                                    <option value="">-- Select Phase --</option>
                                    {% for phase in payment_phases %}
                                        <option value="{{ phase.phase_id }}">{{ phase.name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Payment Amount (BDT)</label>
                            <div class="col-sm-9">
                                <input type="number" name="amount" class="form-control" step="0.01" min="0.01" required>
                            </div>
                        </div>
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Payment Date</label>
                            <div class="col-sm-9">
                                <input type="date" name="payment_date" value="{{ payment_date }}" class="form-control" required>
                            </div>
                        </div>
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Payment Method</label>
                            <div class="col-sm-9">
                                <select name="payment_method" class="form-select" required>
                                    {% for method_key, method_name in payment_methods %}
                                        <option value="{{ method_key }}" {{ method_key == payment_method ? 'selected' : '' }}>{{ method_name }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Reference Number</label>
                            <div class="col-sm-9">
                                <input type="text" name="reference_number" class="form-control" placeholder="Transaction ID / Check No / Mobile Banking Ref">
                                <small class="text-muted">Optional: Reference number from payment gateway or bank</small>
                            </div>
                        </div>
                        
                    </div>
                </div>
                
                <div class="alert alert-info">
                    <i class="fas fa-solid fa-info-circle"></i>
                    <strong>Note:</strong> This payment will be automatically allocated to the selected shareholder and phase. The shareholder's due will be updated accordingly.
                </div>
                
                <input type="hidden" name="user_token" value="{{ user_token }}">
            </form>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

{{ footer }}