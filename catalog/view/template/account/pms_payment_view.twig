                        </div>
                        
                    </div>
                </div>
            </div>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

<script>
function numberToWords(num) {
    if (!num || isNaN(num)) return 'Zero Taka Only';
    
    var taka = Math.floor(num);
    var poisha = Math.round((num - taka) * 100);
    
    var ones = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
                'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen',
                'Seventeen', 'Eighteen', 'Nineteen'];
    var tens = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];
    
    function convert(n) {
        if (n === 0) return '';
        if (n < 20) return ones[n];
        if (n < 100) return tens[Math.floor(n/10)] + (n%10 ? ' ' + ones[n%10] : '');
        if (n < 1000) return ones[Math.floor(n/100)] + ' Hundred' + (n%100 ? ' ' + convert(n%100) : '');
        if (n < 100000) return convert(Math.floor(n/1000)) + ' Thousand' + (n%1000 ? ' ' + convert(n%1000) : '');
        if (n < 10000000) return convert(Math.floor(n/100000)) + ' Lakh' + (n%100000 ? ' ' + convert(n%100000) : '');
        return convert(Math.floor(n/10000000)) + ' Crore' + (n%10000000 ? ' ' + convert(n%10000000) : '');
    }
    
    var result = '';
    if (taka > 0) {
        result = convert(taka) + ' Taka';
    }
    if (poisha > 0) {
        result += (result ? ' and ' : '') + convert(poisha) + ' Poisha';
    }
    if (result === '') result = 'Zero Taka';
    
    return result + ' Only';
}

$(document).ready(function() {
    var amount = parseFloat('{{ payment.amount }}');
    $('#amount-in-words').text('{{ payment["amount_in_words"] }}');
});

// Improved print function with page break prevention
function printReceipt() {
    // Store original page title
    var originalTitle = document.title;
    
    // Set print-friendly title
    document.title = 'Money Receipt - ' + '{{ payment.shareholder_name }}';
    
    // Add a class to body for print-specific styling
    document.body.classList.add('printing');
    
    // Trigger print
    window.print();
    
    // Restore title after print dialog closes
    setTimeout(function() {
        document.title = originalTitle;
        document.body.classList.remove('printing');
    }, 500);
}

// Replace the onclick event for print button
$(document).ready(function() {
    // Update the print button to use the new function
    $('.btn-print').off('click').on('click', function(e) {
        e.preventDefault();
        printReceipt();
    });
});
</script>

