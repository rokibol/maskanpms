{{ header }}
<style>
    /* ============================================================
   Accountant Registration Form — Header Info Card + Save Button
   ============================================================ */
/* ============================================================
   PMS Page Title (used inside .pms-page-header)
   ============================================================ */
.pms-page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #e5e7eb;
    flex-wrap: wrap;
}

.pms-page-header h1 {
    font-size: 1.5rem;
    font-weight: 600;
    color: #0B3C5D;
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1.25;
    letter-spacing: 0.2px;
}

/* Small brand accent bar before the title */
.pms-page-header h1::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 1.4rem;
    border-radius: 2px;
    background: linear-gradient(180deg, #0B3C5D 0%, #1F8A4D 100%);
    flex-shrink: 0;
}

/* Optional: a right-side slot for buttons (e.g. Back) — unused now but ready */
.pms-page-header .pms-page-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

/* ---- Mobile (<576px): compact, wrap-safe title ---- */
@media (max-width: 575.98px) {
    .pms-page-header {
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
        gap: 0.5rem;
    }
    .pms-page-header h1 {
        font-size: 1.15rem;
        line-height: 1.3;
        gap: 0.5rem;
    }
    .pms-page-header h1::before {
        height: 1.05rem;
        width: 3px;
    }
}

/* ---- Tablet (577px – 991px): mid size ---- */
@media (min-width: 576px) and (max-width: 991.98px) {
    .pms-page-header h1 {
        font-size: 1.3rem;
    }
}
/* Info card (Project Name / Total Shares) */
.pms-info-share-register {
    background: #f5f9ff;
    border: 1px solid #d6e4f5;
    border-left: 4px solid #1F8A4D;   /* green accent */
    border-radius: 5px;
    padding: 0.9rem 1.1rem;
    margin-bottom: 1.25rem;
}

.pms-info-share-register .row {
    margin: 0;
    width: 100%;
    gap: 1.5rem;
}

.pms-info-share-register .pms-form-label {
    display: block;
    margin: 0;
    font-size: 0.8rem;
    color: #6B7280;
    letter-spacing: 0.2px;
}

.pms-info-share-register .pms-form-label b {
    display: inline-block;
    color: #0B3C5D;
    font-size: 0.9rem;
    margin-left: 0.25rem;
    font-weight: 600;
}

/* Save button area */
.pms-save-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 0.5rem;
}

.pms-save-actions .btn {
    padding: 0.65rem 1.75rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 5px;
    letter-spacing: 0.3px;
}

.pms-save-actions .btn i {
    margin-right: 0.35rem;
}

/* Mobile: stack the info labels and full-width save button */
@media (max-width: 575.98px) {
    .pms-info-share-register .row {
        flex-direction: column;
        gap: 0.5rem;
    }
    .pms-save-actions .btn {
        width: 100%;
        justify-content: center;
    }
}
</style>
<div class="container-fluid">
    <div class="row">
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="pms-page-header">
                <h1>{{ text_form }}</h1>
            </div>
            <div class="pms-info-share-register">
                <div class="row">
                    <div class="col-auto">
                        <label class="pms-form-label">Project Name: <b>{{ project_name }}</b></label>
                    </div>
                    <div class="col-auto">
                        <label class="pms-form-label">Total Shares: <b>{{ total_shares }}</b></label>
                    </div>
                </div>
            </div>
            <form id="form-customer" action="{{ action }}" method="post" data-oc-toggle="ajax">
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="fas fa-solid fa-user"></i> Accountant Information
                    </div>
                    <div class="card-body">
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">First Name</label>
                            <div class="col-sm-9">
                                <input type="text" name="firstname" value="{{ firstname }}" class="form-control" required>
                            </div>
                        </div>
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Last Name</label>
                            <div class="col-sm-9">
                                <input type="text" name="lastname" value="{{ lastname }}" class="form-control" required>
                            </div>
                        </div>
                        
                        {#<div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Email Address</label>
                            <div class="col-sm-9">
                                <input type="email" name="email" value="{{ email }}" class="form-control" required>
                                <small class="text-muted">This will be used for login</small>
                            </div>
                        </div>#}
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Phone Number</label>
                            <div class="col-sm-9">
                                <input type="tel" name="telephone" value="{{ telephone }}" class="form-control">
                                <small class="text-muted">This will be used for login</small>
                            </div>
                        </div>
                        
                        <div class="row mb-3 {% if not customer_id %}required{% endif %}">
                            <label class="col-sm-3 col-form-label">Password</label>
                            <div class="col-sm-9">
                                <input type="password" name="password" value="{{ password }}" class="form-control" {% if not customer_id %}required{% endif %}>
                                {% if customer_id %}
                                    <small class="text-muted">Leave empty to keep current password</small>
                                {% else %}
                                    <small class="text-muted">Minimum 4 characters</small>
                                {% endif %}
                            </div>
                        </div>
                        
                        <div class="row mb-3 {% if not customer_id %}required{% endif %}">
                            <label class="col-sm-3 col-form-label">Confirm Password</label>
                            <div class="col-sm-9">
                                <input type="password" name="confirm" value="{{ confirm }}" class="form-control" {% if not customer_id %}required{% endif %}>
                            </div>
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="fas fa-solid fa-info-circle"></i>
                            This accountant will be assigned to the project: <strong>{{ project_name }}</strong>
                        </div>
                        <div class="pms-save-actions">
                            <button type="submit" form="form-customer" class="btn btn-primary">
                                <i class="fas fa-regular fa-floppy-disk"></i> {{ button_save }}
                            </button>
                        </div>
                    </div>
                </div>
                
                <input type="hidden" name="user_token" value="{{ user_token }}">
                <input type="hidden" name="project_id" value="{{ project_id }}">
            </form>
        </div>
        
    </div>
</div>
<script>
    // ======================================================
// HANDLE AJAX ERRORS FROM SERVER
// ======================================================
$(document).ajaxComplete(function(event, xhr, settings) {
    if (settings.url && settings.url.indexOf('register_shareholder.save') !== -1) {
        try {
            var response = JSON.parse(xhr.responseText);
            
            if (response.error) {
                // Re-enable submit button
                var submitBtn = document.getElementById('submit-btn');
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="fa-regular fa-circle-check"></i> Save Shareholder';
                
                // Show errors and go to appropriate step
                if (typeof response.error === 'object') {
                    // Field errors - go to step 1 or 2
                    if (response.error.firstname || response.error.lastname || 
                        response.error.email || response.error.password) {
                        goToStep(1);
                    } else if (response.error.ownership_units) {
                        goToStep(2);
                    }
                    
                    // Show field errors
                    Object.keys(response.error).forEach(function(field) {
                        var input = document.querySelector('[name="' + field + '"]');
                        if (input) {
                            input.classList.add('is-invalid');
                        }
                    });
                } else {
                    alert(response.error);
                }
            }
        } catch (e) {
            console.log('Error parsing response:', e);
        }
    }
});
</script>
{{ footer }}