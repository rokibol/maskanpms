{{ header }}

{# ==================== MAIN CONTAINER ==================== #}
<div id="account-account" class="container-fluid pms-manager-dashboard">

    {# Success/Error Alerts #}
    {% if success %}
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-solid fa-circle-check"></i> {{ success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
            <i class="fas fa-solid fa-circle-exclamation"></i> {{ error_warning }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="row">

        {# Left Column - Sidebar #}
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>

        {# Main Content Area #}
        <div id="content" class="col-lg-9 col-md-8">
            {{ content_top }}

            {# ==================== WELCOME HERO SECTION ==================== #}
            <div class="pms-welcome-hero">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2>Welcome back, {{ manager_name }}!</h2>
                        <p>Here's your project overview and key metrics.</p>
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            <span class="pms-badge">
                                <i class="fas fa-regular fa-users"></i> {{ total_shareholders }} Shareholders
                            </span>
                            <span class="pms-badge">
                                <i class="fas fa-regular fa-chart-pie"></i> {{ total_shares }} Total Shares
                            </span>
                        </div>
                    </div>
                    <div>
                        <small class="opacity-75">Project Status:
                            <strong>{{ project_status|capitalize }}</strong>
                        </small>
                    </div>
                </div>
            </div>

            {# ==================== ROW 1: 4-column metrics row ==================== #}
            <div class="row g-3 mb-3">

                {# --- 1) Total Apartments --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon primary-bg">
                            <i class="fas fa-regular fa-building"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Total Apartments</div>
                            <div class="pms-stat-value">{{ total_apartments|default('0') }}</div>
                            <div class="pms-stat-sub">{{ occupied_apartments|default('0') }} occupied</div>
                        </div>
                    </div>
                </div>

                {# --- 2) Total Collections (clickable) --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card pms-stat-card-clickable"
                        role="button"
                        tabindex="0"
                        onclick="openCollectionBreakdown()"
                        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openCollectionBreakdown();}">
                        <div class="pms-stat-icon blue-bg">
                            <i class="fas fa-regular fa-credit-card"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="pms-stat-label">Total Collections</div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-pill pms-stat-action d-none d-lg-inline-flex py-0 px-2"
                                        onclick="event.stopPropagation(); openCollectionBreakdown();">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <div class="pms-stat-value">৳ {{ total_collections|default('0') }}</div>
                            <div class="pms-stat-sub">From {{ paying_shareholders|default('0') }} shareholders</div>
                        </div>
                    </div>
                </div>

                {# --- 3) Total Expenses --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon green-bg">
                            <i class="fas fa-regular fa-chart-line"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Total Expenses</div>
                            <div class="pms-stat-value">৳ {{ total_expenses|default('0') }}</div>
                            <div class="pms-stat-sub">Construction phase</div>
                        </div>
                    </div>
                </div>

                {# --- 4) Collection Progress (ring) --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card pms-stat-progress-card">
                        <div class="pms-stat-icon warning-bg">
                            <i class="fas fa-regular fa-chart-simple"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Collection Progress</div>

                            <div class="pms-progress-ring">
                                <svg viewBox="0 0 120 120" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" overflow="visible">
                                    <circle cx="60" cy="60" r="54" fill="none" stroke="#F5F7FA" stroke-width="12"/>
                                    <circle cx="60" cy="60" r="54" fill="none" stroke="#1F8A4D" stroke-width="12"
                                            stroke-linecap="round"
                                            transform="rotate(-90 60 60)"
                                            stroke-dasharray="{{ (collection_percentage * 3.39)|round }}, 339"
                                            stroke-dashoffset="0"/>
                                </svg>
                                <div class="pms-progress-ring-text">{{ collection_percentage|default('0') }}%</div>
                            </div>

                            <div class="pms-stat-progress-caption">
                                ৳ {{ total_collections|default('0') }} of ৳ {{ total_due|default('0') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ==================== COLLAPSIBLE TOGGLE ==================== #}
            <div class="pms-collapsible-header" id="pmsDetailsToggle" role="button" tabindex="0" aria-expanded="true" aria-controls="pmsDetailsBody">
                <div class="d-flex align-items-center gap-2">
                    <div class="pms-collapsible-icon">
                        <i class="fas fa-regular fa-rectangle-list"></i>
                    </div>
                    <div>
                        <div class="pms-collapsible-title">Project Analytics &amp; Activity</div>
                        <div class="pms-collapsible-sub">Expense breakdown, recent expenses, top shareholders &amp; recent payments</div>
                    </div>
                </div>
                <button type="button" class="pms-collapsible-btn" aria-label="Toggle details">
                    <i class="fas fa-regular fa-chevron-down pms-collapsible-chevron"></i>
                    <span class="pms-collapsible-btn-label">Show details</span>
                </button>
            </div>

            {# ==================== COLLAPSIBLE BODY ==================== #}
            <div class="pms-collapsible-body" id="pmsDetailsBody">
                {# ==================== ROW 2: Expense Breakdown + Recent Expenses ==================== #}
                <div class="row g-3 mb-3">

                    {# --- Expense Breakdown --- #}
                    <div class="col-12 col-lg-6">
                        <div class="pms-card">
                            <div class="pms-section-header">
                                <h4 class="pms-section-title">
                                    <i class="fas fa-regular fa-chart-pie"></i> Expense Breakdown
                                </h4>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadExpenseBreakdown()">
                                    <i class="fas fa-sync-alt"></i> <span class="d-none d-sm-inline">Load</span>
                                </button>
                            </div>
                            <div class="mt-2" id="expense-breakdown-container">
                                <div class="pms-empty-loader">
                                    <i class="fas fa-chart-pie fa-2x mb-2"></i>
                                    <p class="mb-0">Click on <strong>Load</strong> to view the <strong>Expense Breakdown</strong>.</p>
                                </div>
                            </div>
                            <div class="text-end mt-2">
                                <a href="{{ expense_report_link }}" class="pms-view-all">View Details <i class="fas fa-solid fa-arrow-right ms-1"></i></a>
                            </div>
                        </div>
                    </div>

                    {# --- Recent Expenses --- #}
                    <div class="col-12 col-lg-6">
                        <div class="pms-card">
                            <div class="pms-section-header">
                                <h4 class="pms-section-title">
                                    <i class="fas fa-regular fa-receipt"></i> Recent Expenses
                                </h4>
                                <div class="d-flex gap-2 align-items-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadRecentExpenses()">
                                        <i class="fas fa-sync-alt"></i> <span class="d-none d-sm-inline">Load</span>
                                    </button>
                                    <a href="{{ all_expenses_link }}" class="pms-view-all">
                                        View All <i class="fas fa-solid fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="table-responsive" id="recent-expenses-wrapper" style="display: none;">
                                <table class="pms-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Invoice #</th>
                                            <th>Supplier</th>
                                            <th>Payment Count</th>
                                            <th>Paid Amount</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody id="recent-expenses-body"></tbody>
                                </table>
                            </div>

                            <div class="pms-empty-loader" id="recent-expenses-placeholder">
                                <i class="fas fa-receipt fa-2x mb-2"></i>
                                <p class="mb-0">Click on <strong>Load</strong> to view the <strong>Recent Expenses</strong>.</p>
                            </div>
                        </div>
                    </div>
                </div>

                {# ==================== ROW 3: Top Shareholders + Recent Payments ==================== #}
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="pms-card">
                            <div class="pms-section-header flex-wrap gap-2">
                                <h5 class="mb-0 pms-section-title">Top Shareholders</h5>
                                <div class="d-flex gap-2 align-items-center">
                                    <select id="top-shareholder-criteria" class="form-select form-select-sm w-auto">
                                        <option value="ownership">By Ownership %</option>
                                        <option value="paid">By Total Paid</option>
                                        <option value="due">By Outstanding Due</option>
                                    </select>
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadTopShareholders()">
                                        <i class="fas fa-sync-alt"></i> <span class="d-none d-sm-inline">Load</span>
                                    </button>
                                </div>
                            </div>
                            <div class="table-responsive" id="top-shareholders-wrapper" style="display: none;">
                                <table class="pms-table">
                                    <thead>
                                        <tr>
                                            <th>Shareholder</th>
                                            <th>Code</th>
                                            <th>Ownership %</th>
                                            <th>Units</th>
                                            <th>Total Paid</th>
                                            <th>Outstanding</th>
                                        </tr>
                                    </thead>
                                    <tbody id="top-shareholders-body"></tbody>
                                </table>
                            </div>

                            <div class="pms-empty-loader" id="top-shareholders-placeholder">
                                <i class="fas fa-users fa-2x mb-2"></i>
                                <p class="mb-0">Click on <strong>Load</strong> to view the <strong>Top Shareholders</strong>.</p>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="pms-card">
                            <div class="pms-section-header">
                                <h4 class="pms-section-title">
                                    <i class="fas fa-regular fa-clock-rotate-left"></i> Recent Payments
                                </h4>
                                <div class="d-flex gap-2 align-items-center">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadRecentPayments()">
                                        <i class="fas fa-sync-alt"></i> <span class="d-none d-sm-inline">Load</span>
                                    </button>
                                    <a href="{{ all_payments_link }}" class="pms-view-all">
                                        View All <i class="fas fa-solid fa-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="table-responsive" id="recent-payments-wrapper" style="display: none;">
                                <table class="pms-table">
                                    <thead>
                                        <tr>
                                            <th>Date</th>
                                            <th>Shareholder</th>
                                            <th>Phase</th>
                                            <th>Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody id="recent-payments-body"></tbody>
                                </table>
                            </div>

                            <div class="pms-empty-loader" id="recent-payments-placeholder">
                                <i class="fas fa-credit-card fa-2x mb-2"></i>
                                <p class="mb-0">Click on <strong>Load</strong> to view the <strong>Recent Payments</strong>.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {{ content_bottom }}
        </div>

    </div>
</div>

<script>
// ==================== LOADERS ====================
function loadExpenseBreakdown() {
    $('#expense-breakdown-container').html(
        '<div class="text-center py-3"><i class="fas fa-spinner fa-spin text-primary"></i> Loading...</div>'
    );
    $.ajax({
        url: 'index.php?route=account/manager.loadExpenseBreakdown&language={{ language }}&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'html',
        success: function(html) {
            $('#expense-breakdown-container').html(html);
        },
        error: function() {
            $('#expense-breakdown-container').html('<p class="text-danger text-center">Failed to load.</p>');
        }
    });
}

function loadRecentExpenses() {
    // Show loading inside the wrapper
    $('#recent-expenses-wrapper').show();
    $('#recent-expenses-placeholder').hide();
    $('#recent-expenses-body').html(
        '<tr><td colspan="6" class="text-center py-4"><i class="fas fa-spinner fa-spin text-primary"></i> Loading...</td></tr>'
    );

    $.ajax({
        url: 'index.php?route=account/manager.loadRecentExpenses&language={{ language }}&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'html',
        success: function(html) {
            $('#recent-expenses-body').html(html);
        },
        error: function() {
            $('#recent-expenses-body').html('<tr><td colspan="6" class="text-center text-danger py-3">Failed to load.</td></tr>');
        }
    });
}

function loadTopShareholders() {
    var criteria = $('#top-shareholder-criteria').val();
    $('#top-shareholders-wrapper').show();
    $('#top-shareholders-placeholder').hide();
    $('#top-shareholders-body').html(
        '<tr><td colspan="6" class="text-center py-3"><i class="fas fa-spinner fa-spin text-primary"></i> Loading...</td></tr>'
    );

    $.ajax({
        url: 'index.php?route=account/manager.loadTopShareholders&language={{ language }}&customer_token={{ customer_token }}&criteria=' + criteria,
        type: 'GET',
        dataType: 'html',
        success: function(html) {
            $('#top-shareholders-body').html(html);
        },
        error: function() {
            $('#top-shareholders-body').html('<tr><td colspan="6" class="text-center text-danger py-3">Failed to load.</td></tr>');
        }
    });
}

function loadRecentPayments() {
    $('#recent-payments-wrapper').show();
    $('#recent-payments-placeholder').hide();
    $('#recent-payments-body').html(
        '<tr><td colspan="4" class="text-center py-3"><i class="fas fa-spinner fa-spin text-primary"></i> Loading...</td></tr>'
    );

    $.ajax({
        url: 'index.php?route=account/manager.loadRecentPayments&language={{ language }}&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'html',
        success: function(html) {
            $('#recent-payments-body').html(html);
        },
        error: function() {
            $('#recent-payments-body').html('<tr><td colspan="4" class="text-center text-danger py-3">Failed to load.</td></tr>');
        }
    });
}

// Auto-reload top shareholders when criteria changes (only if already loaded once)
$('#top-shareholder-criteria').on('change', function() {
    // Only reload if the table already has data (not the initial "Click Load" placeholder)
    if ($('#top-shareholders-body').find('tr').length && !$('#top-shareholders-body').find('.fa-info-circle').length) {
        loadTopShareholders();
    }
});

// ==================== COLLECTION BREAKDOWN MODAL ====================
function openCollectionBreakdown() {
    $('#collectionBreakdownModal').modal('show');
    $('#collection-breakdown-content').html(
        '<div class="text-center py-4">' +
            '<i class="fa-solid fa-spinner fa-spin fa-2x text-primary"></i>' +
            '<p class="mt-2 text-muted">Loading collection breakdown...</p>' +
        '</div>'
    );

    $.ajax({
        url: 'index.php?route=account/manager.getCollectionBreakdown&language={{ language }}&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            if (data.success && data.data.length > 0) {
                var html = '<div class="table-responsive">';
                html += '<table class="table table-bordered table-striped">';
                html += '<thead><tr><th>Phase</th><th>Transactions</th><th class="text-end">Total Collected</th><th class="text-end">Average per Transaction</th></tr></thead><tbody>';

                var grandTotal = 0;
                var grandTransactions = 0;

                for (var i in data.data) {
                    var row = data.data[i];
                    var avg = row.total_transactions > 0 ? row.total_collected_amount / row.total_transactions : 0;
                    grandTotal += parseFloat(row.total_collected_amount);
                    grandTransactions += parseInt(row.total_transactions);

                    html += '<tr>';
                    html += '<td><strong>' + row.phase_name + '</strong></td>';
                    html += '<td>' + row.total_transactions + '</td>';
                    html += '<td class="text-end text-success">৳ ' + parseFloat(row.total_collected_amount).toFixed(2) + '</td>';
                    html += '<td class="text-end">৳ ' + avg.toFixed(2) + '</td>';
                    html += '</tr>';
                }

                html += '</tbody><tfoot class="fw-bold"><tr>';
                html += '<td><strong>Grand Total</strong></td>';
                html += '<td>' + grandTransactions + '</td>';
                html += '<td class="text-end text-success">৳ ' + grandTotal.toFixed(2) + '</td>';
                html += '<td class="text-end">-</td>';
                html += '</tr></tfoot></table></div>';

                $('#collection-breakdown-content').html(html);
            } else {
                $('#collection-breakdown-content').html(
                    '<div class="text-center py-4">' +
                        '<i class="fas fa-regular fa-inbox fa-2x text-muted mb-2 d-block"></i>' +
                        '<p class="text-muted">No collection data found</p>' +
                    '</div>'
                );
            }
        },
        error: function() {
            $('#collection-breakdown-content').html(
                '<div class="alert alert-danger"><i class="fas fa-regular fa-circle-exclamation"></i> Failed to load.</div>'
            );
        }
    });
}
</script>

<!-- ==================== COLLECTION BREAKDOWN MODAL ==================== -->
<div class="modal fade" id="collectionBreakdownModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-regular fa-credit-card"></i> Collection Breakdown
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="collection-breakdown-content">
                <div class="text-center py-4">
                    <i class="fas fa-solid fa-spinner fa-spin fa-2x text-primary"></i>
                    <p class="mt-2 text-muted">Loading collection breakdown...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script>
$(document).ready(function() {
    var $toggle = $('#pmsDetailsToggle');
    var $body   = $('#pmsDetailsBody');

    // Start OPEN by default. If you want it CLOSED initially, uncomment the next block:
    $toggle.addClass('collapsed').attr('aria-expanded', 'false');
    $body.addClass('collapsed');
    $toggle.find('.pms-collapsible-btn-label').text('Show details');

    function toggleDetails() {
        var isCollapsed = $body.hasClass('collapsed');

        if (isCollapsed) {
            // Expand
            $body.removeClass('collapsed');
            $toggle.removeClass('collapsed').attr('aria-expanded', 'true');
            $toggle.find('.pms-collapsible-btn-label').text('Hide details');
        } else {
            // Collapse
            $body.addClass('collapsed');
            $toggle.addClass('collapsed').attr('aria-expanded', 'false');
            $toggle.find('.pms-collapsible-btn-label').text('Show details');
        }
    }

    // Click on the whole header area OR the inner button
    $toggle.on('click', function(e) {
        // If the click target is the button itself, avoid double toggle
        // (button is inside header, but we handle at header level only)
        toggleDetails();
    });

    // Prevent the inner button from triggering a second handler (if any)
    $toggle.find('.pms-collapsible-btn').on('click', function(e) {
        e.stopPropagation();
        toggleDetails();
    });

    // Keyboard accessibility
    $toggle.on('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
            e.preventDefault();
            toggleDetails();
        }
    });
});
</script>
{{ footer }}