{{ header }}

{# ==================== MAIN CONTAINER ==================== #}
<div id="account-account" class="container-fluid pms-manager-dashboard">

    {# Success/Error Alerts #}
    {% if success %}
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-solid fa-circle-check"></i> {{ success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
            <i class="fas fa-solid fa-circle-exclamation"></i> {{ error_warning }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="row">

        {# Left Column - Sidebar #}
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>

        {# Main Content Area #}
        <div id="content" class="col-lg-9 col-md-8">
            {{ content_top }}

            {# ==================== WELCOME HERO SECTION ==================== #}
            <div class="pms-welcome-hero">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2>Welcome back, {{ manager_name }}!</h2>
                        <p>Here's your project overview and key metrics.</p>
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            <span class="pms-badge">
                                <i class="fas fa-regular fa-users"></i> {{ total_shareholders }} Shareholders
                            </span>
                            <span class="pms-badge">
                                <i class="fas fa-regular fa-chart-pie"></i> {{ total_shares }} Total Shares
                            </span>
                        </div>
                    </div>
                    <div>
                        <small class="opacity-75">Project Status:
                            <strong>{{ project_status|capitalize }}</strong>
                        </small>
                    </div>
                </div>
            </div>

            {# ==================== ROW 1: 4-column metrics row ==================== #}
            <div class="row g-3 mb-3">

                {# --- 1) Total Apartments --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon primary-bg">
                            <i class="fas fa-regular fa-building"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Total Apartments</div>
                            <div class="pms-stat-value">{{ total_apartments|default('0') }}</div>
                            <div class="pms-stat-sub">{{ occupied_apartments|default('0') }} occupied</div>
                        </div>
                    </div>
                </div>

                {# --- 2) Total Collections (clickable) --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card pms-stat-card-clickable"
                        role="button"
                        tabindex="0"
                        onclick="openCollectionBreakdown()"
                        onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openCollectionBreakdown();}">
                        <div class="pms-stat-icon blue-bg">
                            <i class="fas fa-regular fa-credit-card"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <div class="pms-stat-label">Total Collections</div>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-pill pms-stat-action d-none d-lg-inline-flex py-0 px-2"
                                        onclick="event.stopPropagation(); openCollectionBreakdown();">
                                    <i class="fa-regular fa-eye"></i>
                                </button>
                            </div>
                            <div class="pms-stat-value">৳ {{ total_collections|default('0') }}</div>
                            <div class="pms-stat-sub">From {{ paying_shareholders|default('0') }} shareholders</div>
                        </div>
                    </div>
                </div>

                {# --- 3) Total Expenses --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon green-bg">
                            <i class="fas fa-regular fa-chart-line"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Total Expenses</div>
                            <div class="pms-stat-value">৳ {{ total_expenses|default('0') }}</div>
                            <div class="pms-stat-sub">Construction phase</div>
                        </div>
                    </div>
                </div>

                {# --- 4) Collection Progress (ring) --- #}
                <div class="col-6 col-lg-3">
                    <div class="pms-stat-card pms-stat-progress-card">
                        <div class="pms-stat-icon warning-bg">
                            <i class="fas fa-regular fa-chart-simple"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Collection Progress</div>

                            <div class="pms-progress-ring">
                                <svg viewBox="0 0 120 120" width="100%" height="100%" preserveAspectRatio="xMidYMid meet" overflow="visible">
                                    <circle cx="60" cy="60" r="54" fill="none" stroke="#F5F7FA" stroke-width="12"/>
                                    <circle cx="60" cy="60" r="54" fill="none" stroke="#1F8A4D" stroke-width="12"
                                            stroke-linecap="round"
                                            transform="rotate(-90 60 60)"
                                            stroke-dasharray="{{ (collection_percentage * 3.39)|round }}, 339"
                                            stroke-dashoffset="0"/>
                                </svg>
                                <div class="pms-progress-ring-text">{{ collection_percentage|default('0') }}%</div>
                            </div>

                            <div class="pms-stat-progress-caption">
                                ৳ {{ total_collections|default('0') }} of ৳ {{ total_due|default('0') }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# ==================== ROW 2: Expense Breakdown + Recent Expenses ==================== #}
            <div class="row g-3 mb-3">

                {# --- Expense Breakdown --- #}
                <div class="col-12 col-lg-6">
                    <div class="pms-card">
                        <div class="pms-section-header">
                            <h4 class="pms-section-title">
                                <i class="fas fa-regular fa-chart-pie"></i> Expense Breakdown
                            </h4>
                        </div>
                        <div class="mt-2">
                            {% for category in expense_categories %}
                                <div class="mb-3">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="small">{{ category.category_name }}</span>
                                        <span class="small fw-bold">৳ {{ category.total_amount }}</span>
                                    </div>
                                    <div class="pms-progress">
                                        <div class="pms-progress-bar" style="width: {{ category.percentage }}%"></div>
                                    </div>
                                </div>
                            {% else %}
                                <p class="text-muted text-center py-3">No expense data available</p>
                            {% endfor %}
                        </div>
                        <div class="text-end mt-2">
                            <a href="{{ expense_report_link }}" class="pms-view-all">View Details <i class="fas fa-solid fa-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>

                {# --- Recent Expenses --- #}
                <div class="col-12 col-lg-6">
                    <div class="pms-card">
                        <div class="pms-section-header">
                            <h4 class="pms-section-title">
                                <i class="fas fa-regular fa-receipt"></i> Recent Expenses
                            </h4>
                            <a href="{{ all_expenses_link }}" class="pms-view-all">
                                View All <i class="fas fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="pms-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Invoice #</th>
                                        <th>Supplier</th>
                                        <th>Payment Count</th>
                                        <th>Paid Amount</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for expense in recent_expenses %}
                                        <tr>
                                            <td>{{ expense.invoice_date }}</td>
                                            <td>{{ expense.invoice_number }}</td>
                                            <td>{{ expense.supplier_name }}</td>
                                            <td>{{ expense.payment_count }}</td>
                                            <td class="text-danger">৳ {{ expense.paid_amount }}</td>
                                            <td>
                                                <span class="pms-status pms-status-paid">{{ expense.payment_status }}</span>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="fas fa-regular fa-inbox fa-2x mb-2 d-block"></i>
                                                No expenses recorded yet
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            {# ==================== ROW 3: Top Shareholders + Recent Payments ==================== #}
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="pms-card">
                        <div class="pms-section-header">
                            <h5 class="mb-0 pms-section-title">Top Shareholders</h5>
                            <select id="top-shareholder-criteria" class="form-select w-auto">
                                <option value="ownership">By Ownership %</option>
                                <option value="paid">By Total Paid</option>
                                <option value="due">By Outstanding Due</option>
                            </select>
                        </div>
                        <div id="top-shareholders-container">
                            <div class="table-responsive">
                                <table class="pms-table">
                                    <thead>
                                        <tr>
                                            <th>Shareholder</th>
                                            <th>Code</th>
                                            <th>Ownership %</th>
                                            <th>Units</th>
                                            <th>Total Paid</th>
                                            <th>Outstanding</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% if top_shareholders %}
                                            {% for shareholder in top_shareholders %}
                                                <tr>
                                                    <td>{{ shareholder.name }}</td>
                                                    <td>{{ shareholder.shareholder_code }}</td>
                                                    <td class="fw-bold">{{ shareholder.percentage|round(2) }}%</td>
                                                    <td>{{ shareholder.ownership_units }} units</td>
                                                    <td class="text-success">৳ {{ shareholder.total_paid|number_format(2) }}</td>
                                                    <td class="text-danger">৳ {{ shareholder.total_due|number_format(2) }}</td>
                                                </tr>
                                            {% endfor %}
                                        {% else %}
                                            <tr>
                                                <td colspan="6" class="text-center text-muted py-3">No shareholder data available</td>
                                            </tr>
                                        {% endif %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="pms-card">
                        <div class="pms-section-header">
                            <h4 class="pms-section-title">
                                <i class="fas fa-regular fa-clock-rotate-left"></i> Recent Payments
                            </h4>
                            <a href="{{ all_payments_link }}" class="pms-view-all">
                                View All <i class="fas fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>

                        <div class="table-responsive">
                            <table class="pms-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Shareholder</th>
                                        <th>Phase</th>
                                        <th>Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for payment in recent_payments %}
                                        <tr>
                                            <td>{{ payment.payment_date }}</td>
                                            <td>{{ payment.shareholder_name }}</td>
                                            <td>{{ payment.phase_name }}</td>
                                            <td class="text-success">+ ৳ {{ payment.amount }}</td>
                                        </tr>
                                    {% else %}
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-3">No payments recorded yet</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            {{ content_bottom }}
        </div>

    </div>
</div>

<script>
// Dynamic top shareholders switching
$('#top-shareholder-criteria').on('change', function() {
    var criteria = $(this).val();

    $.ajax({
        url: 'index.php?route=account/manager.getTopShareholders&language={{ language }}&criteria=' + criteria + '&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'html',
        beforeSend: function() {
            $('#top-shareholders-container').html('<div class="text-center py-4"><i class="fa-solid fa-spinner fa-spin"></i> Loading...</div>');
        },
        success: function(html) {
            $('#top-shareholders-container').html(html);
        },
        error: function() {
            $('#top-shareholders-container').html('<div class="alert alert-danger">Error loading data</div>');
        }
    });
});
</script>
<script>
// ==================== COLLECTION BREAKDOWN MODAL ====================

function openCollectionBreakdown() {
    $('#collectionBreakdownModal').modal('show');
    $('#collection-breakdown-content').html(`
        <div class="text-center py-4">
            <i class="fa-solid fa-spinner fa-spin fa-2x text-primary"></i>
            <p class="mt-2 text-muted">Loading collection breakdown...</p>
        </div>
    `);

    $.ajax({
        url: 'index.php?route=account/manager.getCollectionBreakdown&language={{ language }}&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'json',
        success: function(data) {
            if (data.success && data.data.length > 0) {
                var html = '<div class="table-responsive">';
                html += '<table class="table table-bordered table-striped">';
                html += '<thead><tr>';
                html += '<th>Phase</th>';
                html += '<th>Transactions</th>';
                html += '<th class="text-end">Total Collected</th>';
                html += '<th class="text-end">Average per Transaction</th>';
                html += '</tr></thead><tbody>';

                var grandTotal = 0;
                var grandTransactions = 0;

                for (var i in data.data) {
                    var row = data.data[i];
                    var avg = row.total_transactions > 0 ? row.total_collected_amount / row.total_transactions : 0;
                    grandTotal += parseFloat(row.total_collected_amount);
                    grandTransactions += parseInt(row.total_transactions);

                    html += '<tr>';
                    html += '<td><strong>' + row.phase_name + '</strong></td>';
                    html += '<td>' + row.total_transactions + '</td>';
                    html += '<td class="text-end text-success">৳ ' + parseFloat(row.total_collected_amount).toFixed(2) + '</td>';
                    html += '<td class="text-end">৳ ' + avg.toFixed(2) + '</td>';
                    html += '</tr>';
                }

                html += '</tbody><tfoot class="fw-bold">';
                html += '<tr>';
                html += '<td><strong>Grand Total</strong></td>';
                html += '<td>' + grandTransactions + '</td>';
                html += '<td class="text-end text-success">৳ ' + grandTotal.toFixed(2) + '</td>';
                html += '<td class="text-end">-</td>';
                html += '</tr>';
                html += '</tfoot></table></div>';

                $('#collection-breakdown-content').html(html);
            } else {
                $('#collection-breakdown-content').html(`
                    <div class="text-center py-4">
                        <i class="fas fa-regular fa-inbox fa-2x text-muted mb-2 d-block"></i>
                        <p class="text-muted">No collection data found</p>
                    </div>
                `);
            }
        },
        error: function() {
            $('#collection-breakdown-content').html(`
                <div class="alert alert-danger">
                    <i class="fas fa-regular fa-circle-exclamation"></i>
                    Failed to load collection breakdown. Please try again.
                </div>
            `);
        }
    });
}
</script>

<!-- ==================== COLLECTION BREAKDOWN MODAL ==================== -->
<div class="modal fade" id="collectionBreakdownModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-regular fa-credit-card"></i> Collection Breakdown
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="collection-breakdown-content">
                <div class="text-center py-4">
                    <i class="fas fa-solid fa-spinner fa-spin fa-2x text-primary"></i>
                    <p class="mt-2 text-muted">Loading collection breakdown...</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

{{ footer }}