{{ header }}

<style>
    .expired-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    .expired-card {
        max-width: 600px;
        width: 100%;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        text-align: center;
        margin-bottom: 50px;
    }
    .expired-header {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
    }
    .expired-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
    }
    .icon-wrapper {
        width: 100px;
        height: 100px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        backdrop-filter: blur(4px);
    }
    .icon-wrapper i {
        font-size: 50px;
        color: white;
    }
    .expired-header h2 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 700;
    }
    .expired-body {
        padding: 30px;
    }
    .message-box {
        background: #f8d7da;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        border-left: 4px solid #dc3545;
        text-align: left;
    }
    .message-icon {
        display: inline-block;
        width: 40px;
        height: 40px;
        background: #dc3545;
        border-radius: 50%;
        text-align: center;
        line-height: 40px;
        margin-right: 15px;
    }
    .message-icon i {
        color: white;
        font-size: 18px;
    }
    .message-text {
        display: inline-block;
        vertical-align: middle;
        width: calc(100% - 65px);
    }
    .message-text p {
        margin: 0;
        color: #721c24;
        line-height: 1.6;
    }
    .expiry-info {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 25px;
    }
    .expiry-label {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 5px;
    }
    .expiry-value {
        font-size: 18px;
        font-weight: 600;
        color: #dc3545;
    }
    .rate-info {
        background: #e8f0fe;
        padding: 15px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 20px;
    }
    .rate-amount {
        font-size: 32px;
        font-weight: 700;
        color: #0B3C5D;
    }
    .subscription-form {
        margin-top: 20px;
    }
    .form-group {
        margin-bottom: 15px;
        text-align: left;
    }
    .form-group label {
        font-weight: 600;
        margin-bottom: 8px;
        display: block;
        color: #333;
    }
    .form-select {
        width: 100%;
        padding: 12px;
        border: 1px solid #ddd;
        border-radius: 8px;
        font-size: 14px;
    }
    .price-display {
        background: #e8f5e9;
        padding: 12px;
        border-radius: 8px;
        text-align: center;
        margin: 15px 0;
    }
    .price-amount {
        font-size: 24px;
        font-weight: 700;
        color: #1F8A4D;
    }
    .btn-subscribe {
        background: #1F8A4D;
        color: white;
        border: none;
        padding: 14px 30px;
        border-radius: 50px;
        font-size: 16px;
        font-weight: 600;
        width: 100%;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .btn-subscribe:hover {
        background: #166d3e;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(31, 138, 77, 0.3);
    }
    .btn-logout {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 500;
        width: 100%;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 10px;
    }
    .btn-logout:hover {
        background: #5a6268;
    }
    .footer-note {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #e0e0e0;
        font-size: 12px;
        color: #9CA3AF;
    }
    @media (max-width: 576px) {
        .expired-body {
            padding: 20px;
        }
        .message-text {
            width: 100%;
            margin-top: 10px;
        }
    }
</style>

<div class="container-fluid">
    <div class="expired-container">
        <div class="expired-card">
            <div class="expired-header">
                <div class="icon-wrapper">
                    <i class="fas fa-solid fa-clock"></i>
                </div>
                <h2>{{ heading_title }}</h2>
            </div>
            
            <div class="expired-body">
                <div class="message-box">
                    <div class="message-icon">
                        <i class="fas fa-solid fa-circle-exclamation"></i>
                    </div>
                    <div class="message-text">
                        <p>{{ text_subscription_expired }}</p>
                    </div>
                </div>
                
                <div class="expiry-info">
                    <div class="expiry-label">Your subscription expired on</div>
                    <div class="expiry-value">{{ expiry_date }}</div>
                </div>
                
                <div class="rate-info">
                    <div class="rate-amount">৳ {{ monthly_rate|number_format(0) }}</div>
                    <div>per month</div>
                </div>
                
                <form id="form-subscribe" action="{{ action }}" method="post" data-oc-toggle="ajax">
                    <div class="subscription-form">
                        <div class="form-group">
                            <label>Select Duration</label>
                            <select name="duration_months" id="duration_months" class="form-select" required>
                                <option value="">-- Select Duration --</option>
                                {% for months, label in duration_options %}
                                    <option value="{{ months }}">{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        
                        <div id="price-display" class="price-display" style="display: none;">
                            <div class="price-label">Total Amount</div>
                            <div class="price-amount" id="total-amount">0</div>
                        </div>
                        
                        <button type="submit" class="btn-subscribe mb-5" id="subscribe-btn" disabled>
                            <i class="fas fa-solid fa-credit-card"></i> Renew Subscription
                        </button>
                        <br/>
                        <a href="{{ back }}" class="btn-logout">
                            <i class="fas fa-solid fa-right-from-bracket"></i> Logout
                        </a>
                    </div>
                </form>
                
                <div class="footer-note">
                    <i class="fas fa-regular fa-circle-info"></i>
                    After payment, your subscription will be activated immediately.
                    For assistance, contact support.
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var monthlyRate = {{ monthly_rate }};
    
    $('#duration_months').on('change', function() {
        var months = $(this).val();
        if (months && months > 0) {
            var total = months * monthlyRate;
            $('#total-amount').text('৳ ' + total.toFixed(2));
            $('#price-display').show();
            $('#subscribe-btn').prop('disabled', false);
        } else {
            $('#price-display').hide();
            $('#subscribe-btn').prop('disabled', true);
        }
    });
});
</script>

{{ footer }}