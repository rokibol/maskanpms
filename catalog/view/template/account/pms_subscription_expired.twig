{{ header }}

<style>
    .expired-container {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 5px 20px;
    }
    .expired-card {
        max-width: 650px;
        width: 100%;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        overflow: hidden;
        text-align: center;
    }
    .expired-header {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
    }
    .expired-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
    }
    .icon-wrapper {
        width: 100px;
        height: 100px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        backdrop-filter: blur(4px);
    }
    .icon-wrapper i {
        font-size: 50px;
        color: white;
    }
    .expired-header h2 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 700;
    }
    .expired-body {
        padding: 30px;
    }
    .message-box {
        background: #f8d7da;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 25px;
        border-left: 4px solid #dc3545;
        text-align: left;
    }
    .message-box p {
        margin: 0;
        color: #721c24;
        line-height: 1.6;
    }
    .expiry-info {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 25px;
    }
    .expiry-info .row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #e0e0e0;
    }
    .expiry-info .row:last-child {
        border-bottom: none;
    }
    .expiry-info .label {
        font-weight: 600;
        color: #555;
    }
    .expiry-info .value {
        font-weight: 600;
        color: #333;
    }
    .rate-info {
        background: #e8f0fe;
        padding: 15px;
        border-radius: 12px;
        text-align: center;
        margin-bottom: 20px;
    }
    .rate-amount {
        font-size: 32px;
        font-weight: 700;
        color: #0B3C5D;
    }
    .rate-sub {
        font-size: 13px;
        color: #6c757d;
    }
    .subscription-form {
        margin-top: 20px;
    }
    .duration-option {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 15px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .duration-option:hover {
        border-color: #1F8A4D;
        background: #f8f9fa;
    }
    .duration-option.selected {
        border-color: #1F8A4D;
        background: #e8f5e9;
    }
    .duration-label {
        font-weight: 600;
        font-size: 15px;
    }
    .duration-price {
        font-size: 16px;
        font-weight: 700;
        color: #1F8A4D;
    }
    .btn-subscribe {
        background: #1F8A4D;
        color: white;
        border: none;
        padding: 14px 30px;
        border-radius: 50px;
        font-size: 16px;
        font-weight: 600;
        width: 100%;
        cursor: pointer;
        margin-top: 15px;
        transition: all 0.3s ease;
    }
    .btn-subscribe:hover {
        background: #166d3e;
        transform: translateY(-2px);
    }
    .btn-subscribe:disabled {
        background: #ccc;
        cursor: not-allowed;
        transform: none;
    }
    .btn-logout {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 500;
        width: 100%;
        cursor: pointer;
        margin-top: 10px;
        transition: all 0.3s ease;
    }
    .btn-logout:hover {
        background: #5a6268;
    }
    .help-section {
        margin-top: 20px;
        padding-top: 15px;
        border-top: 1px solid #e0e0e0;
        font-size: 13px;
        color: #6c757d;
    }
    .help-section a {
        color: #1F8A4D;
        text-decoration: none;
    }
    .help-section a:hover {
        text-decoration: underline;
    }
    @media (max-width: 576px) {
        .expired-body {
            padding: 20px;
        }
        .expired-header h2 {
            font-size: 22px;
        }
        .duration-option {
            flex-direction: column;
            text-align: center;
            gap: 5px;
        }
    }
</style>

<div class="container expired-container">
    <div class="expired-card">
        <div class="expired-header">
            <div class="icon-wrapper">
                <i class="fas fa-solid fa-clock"></i>
            </div>
            <h2>{{ heading_title }}</h2>
        </div>
        
        <div class="expired-body">
            <!-- Message -->
            <div class="message-box">
                <p>{{ text_subscription_expired }}</p>
            </div>
            
            <!-- Expiry Info -->
            <div class="expiry-info">
                <div class="row">
                    <span class="label">Project</span>
                    <span class="value">{{ project_name }}</span>
                </div>
                <div class="row">
                    <span class="label">Apartments</span>
                    <span class="value">{{ apartment_count }}</span>
                </div>
                <div class="row">
                    <span class="label">Expired on</span>
                    <span class="value" style="color: #dc3545;">{{ expiry_date }}</span>
                </div>
                <div class="row">
                    <span class="label">Rate per Apartment</span>
                    <span class="value">৳ {{ calculation.rate_per_apartment|number_format(2) }}</span>
                </div>
                {% if calculation.has_discount %}
                <div class="row">
                    <span class="label">Discount</span>
                    <span class="value">
                        <span style="color: #1F8A4D;">
                            {% if calculation.discount_type == 'percentage' %}
                                {{ calculation.discount_value }}%
                            {% else %}
                                ৳ {{ calculation.discount_per_apartment|number_format(2) }}
                            {% endif %}
                        </span>
                        <br>
                        <small style="font-weight: 400; color: #6c757d;">{{ calculation.discount_reason }}</small>
                    </span>
                </div>
                <div class="row">
                    <span class="label">Monthly Subscription</span>
                    <span class="value" style="color: #1F8A4D; font-size: 18px;">৳ {{ calculation.final_monthly|number_format(2) }}</span>
                </div>
                {% else %}
                <div class="row">
                    <span class="label">Monthly Subscription</span>
                    <span class="value" style="color: #1F8A4D; font-size: 18px;">৳ {{ calculation.final_monthly|number_format(2) }}</span>
                </div>
                {% endif %}
            </div>
            
            <!-- Renew Form -->
            <form id="form-renew" action="{{ action }}" method="post" data-oc-toggle="ajax">
                <div class="subscription-form">
                    <div style="text-align: left; margin-bottom: 10px; font-weight: 600; color: #0B3C5D;">
                        Select Duration:
                    </div>
                    
                    {% for months, label in duration_options %}
                        <div class="duration-option" data-months="{{ months }}">
                            <span class="duration-label">{{ label }}</span>
                            <span class="duration-price">৳ {{ duration_amounts[months]|number_format(2) }}</span>
                        </div>
                    {% endfor %}
                    
                    <input type="hidden" name="duration_months" id="selected-duration" value="">
                    
                    <button type="submit" class="btn-subscribe" id="subscribe-btn" disabled>
                        <i class="fas fa-regular fa-credit-card"></i> Renew Subscription
                    </button>
                </div>
            </form>
            
            <button type="button" class="btn-logout" onclick="window.location.href='{{ logout }}'">
                <i class="fas fa-solid fa-right-from-bracket"></i> Logout
            </button>
            
            <div class="help-section">
                <i class="fas fa-regular fa-circle-info"></i>
                Need help? Contact us at 
                <a href="mailto:{{ support_email }}">{{ support_email }}</a> 
                or call <a href="tel:{{ support_phone }}">{{ support_phone }}</a>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function() {
    var selectedMonths = null;
    
    $('.duration-option').on('click', function() {
        $('.duration-option').removeClass('selected');
        $(this).addClass('selected');
        selectedMonths = $(this).data('months');
        $('#selected-duration').val(selectedMonths);
        $('#subscribe-btn').prop('disabled', false);
    });
});
</script>

{{ footer }}