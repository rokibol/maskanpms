{{ header }}

<style>
    .filter-bar {
        background: #f5f5f5;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }
    .status-enabled { background: #e8f5e9; color: #2e7d32; }
    .status-disabled { background: #ffebee; color: #c62828; }
    /* ========== FIX DROPDOWN OVERFLOW ========== */
    .table-responsive {
        overflow-x: auto;
        overflow-y: visible !important;
    }
    
    .table {
        overflow: visible !important;
    }
    
    .table tbody,
    .table tr,
    .table td {
        overflow: visible !important;
    }
    
    .dropdown {
        position: static !important;
    }
    
    .dropdown-menu {
        position: absolute !important;
        z-index: 9999 !important;
        inset: auto auto 0 auto !important;
        min-width: 180px;
    }
    
    /* For the action column - make it position relative */
    .table td:last-child {
        position: relative;
        overflow: visible !important;
    }
    
    /* Ensure parent containers don't clip */
    #content,
    .card-body,
    .table-responsive {
        overflow: visible !important;
    }
    
    /* Fix for the dropdown button container */
    .action-dropdown {
        position: relative !important;
        display: inline-block !important;
    }
    
    .action-dropdown .dropdown-menu {
        position: absolute !important;
        top: 100% !important;
        right: 0 !important;
        left: auto !important;
        bottom: auto !important;
        margin-top: 5px !important;
        transform: translateY(0) !important;
    }
    
    /* Ensure dropdown appears above modal backdrop if any */
    .dropdown-menu.show {
        display: block;
        z-index: 1060;
    }
</style>

<div class="container-fluid">
    {#<ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
            <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>#}
    
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ heading_title }}</h1>
                <div>
                    <a href="{{ add }}" class="btn btn-primary">
                        <i class="fas fa-solid fa-plus"></i> Add Accountant
                    </a>
                    <button type="button" class="btn btn-success" 
                            id="sharePopover"
                            data-bs-container="body" 
                            data-bs-toggle="popover" 
                            data-bs-placement="bottom" 
                            data-bs-html="true"
                            title="Share Registration Link">
                        <i class="fa-solid fa-share-nodes"></i> Share
                    </button>
                    <a href="{{ back }}" class="btn btn-secondary">
                        <i class="fas fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>
            </div>
            
            <!-- Filter Bar -->
            <div class="filter-bar">
                <div class="row g-3">
                    <div class="col-md-5">
                        <input type="text" name="filter_search" value="{{ filter_search }}" class="form-control" placeholder="Search by name or email">
                    </div>
                    <div class="col-md-3">
                        <select name="filter_status" class="form-select">
                            <option value="">All Status</option>
                            {% for status_value, status_name in statuses %}
                                <option value="{{ status_value }}" {{ filter_status == status_value ? 'selected' : '' }}>{{ status_name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-4">
                        <button type="button" id="button-filter" class="btn btn-primary">
                            <i class="fas fa-solid fa-search"></i> Filter
                        </button>
                        <button type="button" id="button-clear" class="btn btn-secondary">
                            <i class="fas fa-solid fa-eraser"></i> Clear
                        </button>
                    </div>
                </div>
            </div>
            
            <!-- Customers Table -->
            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th><a href="{{ sort_name }}">Name</a></th>
                            <th><a href="{{ sort_email }}">Email</a></th>
                            <th>Phone</th>
                            <th><a href="{{ sort_status }}">Status</a></th>
                            <th><a href="{{ sort_date }}">Date Added</a></th>
                            <th class="text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% if customers %}
                            {% for customer in customers %}
                                <tr>
                                    <td>{{ customer.name }}</td>
                                    <td>{{ customer.email }}</td>
                                    <td>{{ customer.telephone }}</td>
                                    <td>{{ customer.status_badge|raw }}</td>
                                    <td>{{ customer.date_added }}</td>
                                    <td class="text-end">
                                        <div class="dropdown action-dropdown" style="position: relative; display: inline-block;">
                                            <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                                <i class="fas fa-solid fa-gear"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li><a class="dropdown-item" href="{{ customer.view }}"><i class="fas fa-regular fa-eye"></i> View</a></li>
                                                <li><a class="dropdown-item" href="{{ customer.edit }}"><i class="fas fa-regular fa-pen-to-square"></i> Edit</a></li>
                                                <li><hr class="dropdown-divider"></li>
                                                <li><a class="dropdown-item text-danger" href="javascript:void(0);" onclick="deleteCustomer({{ customer.customer_id }})"><i class="fas fa-regular fa-trash-can"></i> Delete</a></li>
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="fas fa-regular fa-users fa-2x mb-2 d-block"></i>
                                    No accountants found for this project.
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            
            <div class="row">
                <div class="col-sm-6 text-start">{{ pagination }}</div>
                <div class="col-sm-6 text-end">{{ results }}</div>
            </div>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>
<!-- The Popover Content Template (Injecting Twig Variables safely) -->
<template id="popover-content">
  <div class="p-2 share-panel-wrapper" style="min-width: 220px;">
    
    <!-- Copy Input Group -->
    <div class="input-group input-group-sm mb-3">
      <input type="text" class="form-control text-muted" value="{{ accountant_registration_url }}" readonly id="shareLinkInput">
      <button class="btn btn-primary" type="button" id="btnPopoverCopy" onclick="copyShareLink()">
        <i class="fa-regular fa-copy"></i>
      </button>
    </div>

    <!-- Social Action List -->
    <div class="d-flex flex-column gap-2">
      <!-- WhatsApp (Direct message API) -->
      <a href="https://whatsapp.com{{ accountant_registration_url|url_encode }}" target="_blank" class="btn btn-sm btn-outline-success text-start">
        <i class="fa-brands fa-whatsapp me-2"></i> WhatsApp
      </a>
      
      <!-- Messenger (Requires redirect share intent) -->
      <a href="https://facebook.com{{ accountant_registration_url|url_encode }}&redirect_uri={{ accountant_registration_url|url_encode }}" target="_blank" class="btn btn-sm btn-outline-primary text-start">
        <i class="fa-brands fa-facebook-messenger me-2"></i> Messenger
      </a>

      <!-- Instagram (Direct link share note) -->
      <a href="https://instagram.com" target="_blank" class="btn btn-sm btn-outline-danger text-start" onclick="alert('Instagram does not support direct link passing via URLs. We have copied the link to your clipboard so you can paste it into a DM!'); copyShareLink();">
        <i class="fa-brands fa-instagram me-2"></i> Instagram
      </a>

      <!-- Email (Native Mailto protocol) -->
      <a href="mailto:?subject=Shareholder%20Registration&body=Please%20use%20this%20link%20to%20register%3A%20{{ accountant_registration_url|url_encode }}" class="btn btn-sm btn-outline-secondary text-start">
        <i class="fa-regular fa-envelope me-2"></i> Email Link
      </a>
    </div>

  </div>
</template>
<script>
    $(document).ready(function() {
        var popoverTriggerEl = document.getElementById('sharePopover');
        var templateEl = document.getElementById('popover-content');
        
        // Pull the raw Twig variable directly into JavaScript context
        var shareData = {
            title: 'Accountant Registration',
            text: 'Please use this link to register as a accountant:',
            url: '{{ accountant_registration_url }}'
        };

        if (popoverTriggerEl && templateEl) {
            
            // 1. MOBILE CONDITION: Check if the browser supports native mobile sharing
            if (navigator.share) {
                
                // Remove Bootstrap data attributes so the popover doesn't trigger on mobile
                popoverTriggerEl.removeAttribute('data-bs-toggle');
                popoverTriggerEl.removeAttribute('data-bs-target');
                
                popoverTriggerEl.addEventListener('click', function(e) {
                    e.preventDefault();
                    
                    navigator.share(shareData)
                        .then(() => console.log('Shared successfully'))
                        .catch((err) => console.log('Share canceled or failed:', err));
                });
                
            } else {
                // 2. DESKTOP FALLBACK: Initialize the original Bootstrap Popover layout
                var popover = new bootstrap.Popover(popoverTriggerEl, {
                    content: templateEl.innerHTML,
                    sanitize: false
                });

                // Close the popover wrapper if user clicks outside of it
                $('body').on('click', function (e) {
                    if (!$(popoverTriggerEl).is(e.target) && $(popoverTriggerEl).has(e.target).length === 0 && $('.popover').has(e.target).length === 0) {
                        popover.hide();
                    }
                });
            }
        }
    });

    // Keep your clipboard copy method active for desktop fallbacks
    function copyShareLink() {
        var copyInput = document.querySelector('.popover #shareLinkInput');
        var copyButton = document.querySelector('.popover #btnPopoverCopy');
        
        if (copyInput) {
            copyInput.select();
            copyInput.setSelectionRange(0, 99999);
            navigator.clipboard.writeText(copyInput.value).then(function() {
                if (copyButton) {
                    var originalHtml = copyButton.innerHTML;
                    copyButton.innerHTML = '<i class="fa-solid fa-check"></i>';
                    copyButton.className = "btn btn-success";
                    setTimeout(function() {
                        copyButton.innerHTML = originalHtml;
                        copyButton.className = "btn btn-primary";
                    }, 2000);
                }
            });
        }
    }

    $('#button-filter').on('click', function() {
        var url = 'index.php?route=account/pms_customers&language={{ language }}';
        
        var filter_search = $('input[name="filter_search"]').val();
        if (filter_search) {
            url += '&filter_search=' + encodeURIComponent(filter_search);
        }
        
        var filter_status = $('select[name="filter_status"]').val();
        if (filter_status) {
            url += '&filter_status=' + encodeURIComponent(filter_status);
        }
        
        location = url;
    });

    $('#button-clear').on('click', function() {
        location = 'index.php?route=account/pms_customers&language={{ language }}';
    });

    $('input[name="filter_search"]').keydown(function(e) {
        if (e.keyCode == 13) {
            $('#button-filter').click();
        }
    });

    function deleteCustomer(customerId) {
        if (confirm('Are you sure you want to delete this accountant? They will no longer have access to the system.')) {
            $.ajax({
                url: 'index.php?route=account/pms_customers.delete&language={{ language }}&customer_id=' + customerId + '&user_token={{ user_token }}',
                type: 'GET',
                dataType: 'json',
                success: function(json) {
                    if (json.success) {
                        location.reload();
                    } else {
                        alert(json.error);
                    }
                }
            });
        }
    }
</script>

{{ footer }}