{{ header }}

<style>
    .no-apartment-container {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    .no-apartment-card {
        width: 100%;
        background: white;
        border-radius: 16px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        text-align: center;
    }
    .no-apartment-header {
        background: linear-gradient(135deg, #0B3C5D 0%, #1F8A4D 100%);
        padding: 40px 20px;
        position: relative;
        overflow: hidden;
    }
    .no-apartment-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 200px;
        height: 200px;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 50%;
    }
    .no-apartment-header::after {
        content: '';
        position: absolute;
        bottom: -30%;
        left: -15%;
        width: 150px;
        height: 150px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 50%;
    }
    .icon-wrapper {
        width: 100px;
        height: 100px;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        backdrop-filter: blur(4px);
    }
    .icon-wrapper i {
        font-size: 50px;
        color: white;
    }
    .no-apartment-header h2 {
        color: white;
        margin: 0;
        font-size: 28px;
        font-weight: 700;
    }
    .no-apartment-body {
        padding: 40px 30px;
    }
    .message-box {
        background: #F5F7FA;
        border-radius: 12px;
        padding: 25px;
        margin-bottom: 30px;
        border-left: 4px solid #F59E0B;
        text-align: left;
    }
    .message-icon {
        display: inline-block;
        width: 40px;
        height: 40px;
        background: #FEF3C7;
        border-radius: 50%;
        text-align: center;
        line-height: 40px;
        margin-right: 15px;
    }
    .message-icon i {
        color: #F59E0B;
        font-size: 18px;
    }
    .message-text {
        display: inline-block;
        vertical-align: middle;
        width: calc(100% - 65px);
    }
    .message-text p {
        margin: 0;
        color: #374151;
        line-height: 1.6;
    }
    .help-list {
        text-align: left;
        margin: 20px 0;
        padding: 0;
        list-style: none;
    }
    .help-list li {
        padding: 10px 0;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .help-list li:last-child {
        border-bottom: none;
    }
    .help-list li i {
        width: 24px;
        color: #1F8A4D;
        font-size: 16px;
    }
    .help-list li span {
        color: #555;
        font-size: 14px;
    }
    .btn-contact {
        background: #0B3C5D;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-top: 10px;
    }
    .btn-contact:hover {
        background: #1F8A4D;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(31, 138, 77, 0.3);
    }
    .btn-back {
        background: #E5E7EB;
        color: #374151;
        border: none;
        padding: 12px 30px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        margin-left: 10px;
    }
    .btn-back:hover {
        background: #D1D5DB;
        color: #1F2937;
    }
    .footer-note {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e0e0e0;
        font-size: 12px;
        color: #9CA3AF;
    }
    @media (max-width: 576px) {
        .no-apartment-body {
            padding: 30px 20px;
        }
        .message-text {
            width: 100%;
            margin-top: 10px;
        }
        .btn-contact, .btn-back {
            display: block;
            width: 100%;
            margin: 10px 0;
            justify-content: center;
        }
        .btn-back {
            margin-left: 0;
        }
    }
</style>

<div class="container-fluid">
    {#<ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
            <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>#}
    
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="no-apartment-container">
                <div class="no-apartment-card">
                    <div class="no-apartment-header">
                        <div class="icon-wrapper">
                            <i class="fa-regular fa-building"></i>
                        </div>
                        <h2>{{ heading_title }}</h2>
                    </div>
                    
                    <div class="no-apartment-body">
                        <div class="message-box">
                            <div class="message-icon">
                                <i class="fa-regular fa-info-circle"></i>
                            </div>
                            <div class="message-text">
                                <p>{{ message }}</p>
                            </div>
                        </div>
                        
                        <div class="help-list">
                            <li>
                                <i class="fa-regular fa-envelope"></i>
                                <span>Contact the building manager to request apartment assignment</span>
                            </li>
                            <li>
                                <i class="fa-regular fa-clock"></i>
                                <span>Once assigned, you will receive a confirmation email</span>
                            </li>
                            <li>
                                <i class="fa-regular fa-credit-card"></i>
                                <span>After assignment, you can view bills and make payments</span>
                            </li>
                        </div>
                        
                        <div>
                            <a href="mailto:{{ contact_email|default('support@maskanpms.com') }}" class="btn-contact">
                                <i class="fa-regular fa-envelope"></i> Contact Manager
                            </a>
                            <a href="{{ back }}" class="btn-back">
                                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
                            </a>
                        </div>
                        
                        <div class="footer-note">
                            <i class="fa-regular fa-circle-question"></i>
                            Need immediate assistance? Call us at {{ contact_phone|default('+880 1234 567890') }}
                        </div>
                    </div>
                </div>
            </div>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

{{ footer }}