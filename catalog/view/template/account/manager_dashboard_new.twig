{{ header }}

<style>
    .stat-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 6px;
        padding: 15px;
        margin-bottom: 20px;
    }
    .stat-number {
        font-size: 28px;
        font-weight: 600;
        color: #0B3C5D;
    }
    .stat-label {
        font-size: 13px;
        color: #666;
        margin-top: 5px;
    }
    .section-title {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 15px;
        padding-bottom: 8px;
        border-bottom: 1px solid #e0e0e0;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
    }
    .data-table th {
        background: #f5f5f5;
        padding: 8px 10px;
        text-align: left;
        font-size: 12px;
        font-weight: 600;
        border-bottom: 1px solid #e0e0e0;
    }
    .data-table td {
        padding: 8px 10px;
        font-size: 13px;
        border-bottom: 1px solid #f0f0f0;
    }
    .text-right {
        text-align: right;
    }
    .text-danger { color: #dc3545; }
    .text-success { color: #28a745; }
</style>

<div class="container-fluid">
    {#<ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
            <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
    </ul>#}
    
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <h1 class="mb-4">Manager Dashboard - {{ project_name }}</h1>
            
            <!-- Row 1: Key Numbers -->
            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number">{{ stats.total_shareholders }}</div>
                        <div class="stat-label">Total Shareholders</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number">{{ stats.total_apartments }}</div>
                        <div class="stat-label">Total Apartments</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number text-danger">৳ {{ stats.total_expense_amount|number_format(0) }}</div>
                        <div class="stat-label">Total Expenses</div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="stat-card">
                        <div class="stat-number text-success">৳ {{ stats.total_collection|number_format(0) }}</div>
                        <div class="stat-label">Total Collection</div>
                    </div>
                </div>
            </div>
            
            <!-- Row 2: Financial Status -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="section-title">Collection Status</div>
                        <div class="row">
                            <div class="col-6">
                                <div class="stat-number text-success">৳ {{ stats.total_collection|number_format(0) }}</div>
                                <div class="stat-label">Collected</div>
                            </div>
                            <div class="col-6">
                                <div class="stat-number text-danger">৳ {{ stats.outstanding|number_format(0) }}</div>
                                <div class="stat-label">Outstanding</div>
                            </div>
                        </div>
                        <div class="mt-2">
                            <div class="progress" style="height: 8px;">
                                <div class="progress-bar bg-success" style="width: {{ stats.collection_percentage }}%;"></div>
                            </div>
                            <div class="text-muted small mt-1">Collection Rate: {{ stats.collection_percentage }}%</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="stat-card">
                        <div class="section-title">Monthly Maintenance</div>
                        <div class="stat-number">৳ {{ stats.monthly_maintenance|number_format(0) }}</div>
                        <div class="stat-label">Expected Monthly Revenue</div>
                    </div>
                </div>
            </div>
            
            <!-- Row 3: Recent Transactions -->
            <div class="stat-card">
                <div class="section-title">Recent Expenses</div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Invoice No</th>
                            <th>Description</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for expense in recent_expenses %}
                            <tr>
                                <td>{{ expense.date }}</td>
                                <td>{{ expense.invoice_no }}</td>
                                <td>{{ expense.description|length > 30 ? expense.description|slice(0, 30) ~ '...' : expense.description }}</td>
                                <td class="text-right text-danger">৳ {{ expense.amount|number_format(2) }}</td>
                            </tr>
                        {% else %}
                            <tr><td colspan="4" class="text-center text-muted">No expenses recorded</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="mt-2 text-end">
                    <a href="{{ all_expenses_link }}" class="btn btn-sm btn-link">View All Expenses →</a>
                </div>
            </div>
            
            <!-- Row 4: Recent Payments -->
            <div class="stat-card">
                <div class="section-title">Recent Payments</div>
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Shareholder</th>
                            <th>Phase</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for payment in recent_payments %}
                            <tr>
                                <td>{{ payment.date }}</td>
                                <td>{{ payment.shareholder }}</td>
                                <td>{{ payment.phase }}</td>
                                <td class="text-right text-success">৳ {{ payment.amount|number_format(2) }}</td>
                            </tr>
                        {% else %}
                            <td><td colspan="4" class="text-center text-muted">No payments recorded</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
                <div class="mt-2 text-end">
                    <a href="{{ all_payments_link }}" class="btn btn-sm btn-link">View All Payments →</a>
                </div>
            </div>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

{{ footer }}