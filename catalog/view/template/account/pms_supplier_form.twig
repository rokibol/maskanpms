{{ header }}

<div class="container-fluid">
    
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ text_form }}</h1>
                <div>
                    <button type="submit" form="form-supplier" class="btn btn-primary">
                        <i class="fa-regular fa-floppy-disk"></i> {{ button_save }}
                    </button>
                    <a href="{{ back }}" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> {{ button_back }}
                    </a>
                </div>
            </div>
            
            <form id="form-supplier" action="{{ action }}" method="post" data-oc-toggle="ajax">
                <div class="card mb-3">
                    <div class="card-header">Basic Information</div>
                    <div class="card-body">
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Supplier Name</label>
                            <div class="col-sm-9">
                                <input type="text" name="supplier_name" value="{{ supplier_name }}" class="form-control" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Company Name</label>
                            <div class="col-sm-9">
                                <input type="text" name="company_name" value="{{ company_name }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Contact Person</label>
                            <div class="col-sm-9">
                                <input type="text" name="contact_person" value="{{ contact_person }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Email</label>
                            <div class="col-sm-9">
                                <input type="email" name="email" value="{{ email }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Phone</label>
                            <div class="col-sm-9">
                                <input type="text" name="phone" value="{{ phone }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Mobile</label>
                            <div class="col-sm-9">
                                <input type="text" name="mobile" value="{{ mobile }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Address</label>
                            <div class="col-sm-9">
                                <textarea name="address" rows="3" class="form-control">{{ address }}</textarea>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">City</label>
                            <div class="col-sm-9">
                                <input type="text" name="city" value="{{ city }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Postal Code</label>
                            <div class="col-sm-9">
                                <input type="text" name="postal_code" value="{{ postal_code }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Country</label>
                            <div class="col-sm-9">
                                <input type="text" name="country" value="{{ country }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Status</label>
                            <div class="col-sm-9">
                                <select name="status" class="form-select">
                                    <option value="active" {{ status == 'active' ? 'selected' : '' }}>Active</option>
                                    <option value="inactive" {{ status == 'inactive' ? 'selected' : '' }}>Inactive</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card mb-3">
                    <div class="card-header">Tax & Banking Information</div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">TIN Number</label>
                            <div class="col-sm-9">
                                <input type="text" name="tin_number" value="{{ tin_number }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">BIN Number</label>
                            <div class="col-sm-9">
                                <input type="text" name="bin_number" value="{{ bin_number }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Bank Name</label>
                            <div class="col-sm-9">
                                <input type="text" name="bank_name" value="{{ bank_name }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Bank Account No</label>
                            <div class="col-sm-9">
                                <input type="text" name="bank_account_no" value="{{ bank_account_no }}" class="form-control">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Payment Terms</label>
                            <div class="col-sm-9">
                                <textarea name="payment_terms" rows="3" class="form-control">{{ payment_terms }}</textarea>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Notes</label>
                            <div class="col-sm-9">
                                <textarea name="notes" rows="4" class="form-control">{{ notes }}</textarea>
                            </div>
                        </div>
                    </div>
                </div>
                
                <input type="hidden" name="user_token" value="{{ user_token }}">
            </form>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

{{ footer }}