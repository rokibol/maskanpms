{{ header }}
{# ==================== MAIN CONTAINER ==================== #}
<div id="account-account" class="container-fluid pms-shareholder-dashboard">
    {% if success %}
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-solid fa-circle-check"></i> {{ success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>

        <div id="content" class="col">
            {{ content_top }}

            {# ==================== WELCOME HERO ==================== #}
            <div class="pms-welcome-hero">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                    <div>
                        <h2>Welcome back, {{ customer_name|default('Shareholder') }}!</h2>
                        <p>Here's what's happening with your investment today.</p>
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            <span class="pms-badge">
                                <i class="fas fa-regular fa-building"></i> {{ apartment_number|default('Apt 5A') }}
                            </span>
                        </div>
                    </div>
                    <div>
                        <small class="opacity-75">Member since {{ member_since|default('2024') }}</small>
                    </div>
                </div>
            </div>

            {# ==================== STAT CARDS ==================== #}
            <div class="row g-3 mb-4">
                <div class="col-6 col-md-4">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon danger-bg">
                            <i class="fas fa-regular fa-clock"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Current Due</div>
                            <div class="pms-stat-value">৳ {{ current_due|default('0.00') }}</div>
                            <div class="pms-stat-sub">Total unpaid</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-md-4">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon success-bg">
                            <i class="fas fa-regular fa-credit-card"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Credit Balance</div>
                            <div class="pms-stat-value">৳ {{ credit_balance|default('0.00') }}</div>
                            <div class="pms-stat-sub">Available</div>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon warning-bg">
                            <i class="fas fa-regular fa-file-invoice"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Unpaid Bills</div>
                            <div class="pms-stat-value">৳ {{ total_unpaid_bills|number_format(2) }}</div>
                            <div class="pms-stat-sub">{{ unpaid_bills_count }} bill(s) pending</div>
                        </div>
                    </div>
                </div>
            </div>

            {# ==================== COLLAPSIBLE TOGGLE ==================== #}
            <div class="pms-collapsible-header" id="pmsShareholderDetailsToggle" role="button" tabindex="0" aria-expanded="false" aria-controls="pmsShareholderDetailsBody">
                <div class="d-flex align-items-center gap-2">
                    <div class="pms-collapsible-icon">
                        <i class="fas fa-regular fa-rectangle-list"></i>
                    </div>
                    <div>
                        <div class="pms-collapsible-title">Bills &amp; Transactions</div>
                        <div class="pms-collapsible-sub">Unpaid bills breakdown and recent transactions</div>
                    </div>
                </div>
                <button type="button" class="pms-collapsible-btn" aria-label="Toggle details">
                    <i class="fas fa-regular fa-chevron-down pms-collapsible-chevron"></i>
                    <span class="pms-collapsible-btn-label">Show details</span>
                </button>
            </div>

            {# ==================== COLLAPSIBLE BODY (starts collapsed) ==================== #}
            <div class="pms-collapsible-body collapsed" id="pmsShareholderDetailsBody">

                {# ==================== UNPAID BILLS BREAKDOWN ==================== #}
                {% if unpaid_bills_summary is defined and unpaid_bills_summary %}
                <div class="pms-card mb-4">
                    <div class="pms-section-header">
                        <h4 class="pms-section-title">
                            <i class="fa-regular fa-clock"></i> Unpaid Bills Breakdown
                        </h4>
                        <div class="d-flex gap-2 align-items-center">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadUnpaidBreakdown()">
                                <i class="fas fa-sync-alt"></i> <span>Load</span>
                            </button>
                            <a href="{{ bills_link }}" class="pms-view-all">
                                View All Bills <i class="fa-solid fa-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <div class="table-responsive" id="unpaid-breakdown-wrapper" style="display: none;">
                        <table class="pms-table">
                            <thead>
                                <tr>
                                    <th>Bill Type</th>
                                    <th>Pending Bills</th>
                                    <th>Total Amount</th>
                                    <th>Oldest Month</th>
                                </tr>
                            </thead>
                            <tbody id="unpaid-breakdown-body"></tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="2" class="text-end">Total Unpaid:</th>
                                    <th class="text-danger">৳ {{ total_unpaid_bills|number_format(2) }}</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="pms-empty-loader" id="unpaid-breakdown-placeholder">
                        <i class="fa-regular fa-clock fa-2x mb-2"></i>
                        <p class="mb-0">Click on <strong>Load</strong> to view the <strong>Unpaid Bills Breakdown</strong>.</p>
                    </div>

                    {% if unpaid_bills_summary.earliest_due_date != 'No due date' %}
                        <div class="alert alert-warning mt-3 mb-0">
                            <i class="fa-regular fa-calendar"></i>
                            <strong>Earliest Due Date:</strong> {{ unpaid_bills_summary.earliest_due_date }}
                        </div>
                    {% endif %}
                </div>
                {% endif %}

                {# ==================== RECENT TRANSACTIONS ==================== #}
                <div class="pms-card mb-4">
                    <div class="pms-section-header">
                        <h4 class="pms-section-title">
                            <i class="fas fa-regular fa-clock-rotate-left"></i> Recent Transactions
                        </h4>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="loadRecentTransactions()">
                            <i class="fas fa-sync-alt"></i> <span>Load</span>
                        </button>
                    </div>

                    <div class="table-responsive" id="recent-transactions-wrapper" style="display: none;">
                        <table class="pms-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Description</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="recent-transactions-body"></tbody>
                        </table>
                    </div>

                    <div class="pms-empty-loader" id="recent-transactions-placeholder">
                        <i class="fas fa-clock-rotate-left fa-2x mb-2"></i>
                        <p class="mb-0">Click on <strong>Load</strong> to view the <strong>Recent Transactions</strong>.</p>
                    </div>
                </div>

            </div>
            {# ==================== /COLLAPSIBLE BODY ==================== #}

            {{ content_bottom }}
        </div>

        {{ column_right }}
    </div>
</div>

<script>
// ==================== COLLAPSIBLE TOGGLE ====================
$(document).ready(function() {
    var $toggle = $('#pmsShareholderDetailsToggle');
    var $body   = $('#pmsShareholderDetailsBody');

    // Already starts collapsed from HTML. Sync aria + label.
    $toggle.attr('aria-expanded', 'false');
    $toggle.find('.pms-collapsible-btn-label').text('Show details');

    function toggleDetails() {
        var isCollapsed = $body.hasClass('collapsed');

        if (isCollapsed) {
            $body.removeClass('collapsed');
            $toggle.removeClass('collapsed').attr('aria-expanded', 'true');
            $toggle.find('.pms-collapsible-btn-label').text('Hide details');
        } else {
            $body.addClass('collapsed');
            $toggle.addClass('collapsed').attr('aria-expanded', 'false');
            $toggle.find('.pms-collapsible-btn-label').text('Show details');
        }
    }

    $toggle.on('click', toggleDetails);

    $toggle.find('.pms-collapsible-btn').on('click', function(e) {
        e.stopPropagation();
        toggleDetails();
    });

    $toggle.on('keydown', function(e) {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
            e.preventDefault();
            toggleDetails();
        }
    });
});

// ==================== DATA LOADERS ====================
function loadUnpaidBreakdown() {
    $('#unpaid-breakdown-wrapper').show();
    $('#unpaid-breakdown-placeholder').hide();
    $('#unpaid-breakdown-body').html(
        '<tr><td colspan="4" class="text-center py-3"><i class="fas fa-spinner fa-spin text-primary"></i> Loading...</td></tr>'
    );

    $.ajax({
        url: 'index.php?route=account/shareholder.loadUnpaidBreakdown&language={{ language }}&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'html',
        success: function(html) {
            $('#unpaid-breakdown-body').html(html);
        },
        error: function() {
            $('#unpaid-breakdown-body').html('<tr><td colspan="4" class="text-center text-danger py-3">Failed to load.</td></tr>');
        }
    });
}

function loadRecentTransactions() {
    $('#recent-transactions-wrapper').show();
    $('#recent-transactions-placeholder').hide();
    $('#recent-transactions-body').html(
        '<tr><td colspan="4" class="text-center py-3"><i class="fas fa-spinner fa-spin text-primary"></i> Loading...</td></tr>'
    );

    $.ajax({
        url: 'index.php?route=account/shareholder.loadRecentTransactions&language={{ language }}&customer_token={{ customer_token }}',
        type: 'GET',
        dataType: 'html',
        success: function(html) {
            $('#recent-transactions-body').html(html);
        },
        error: function() {
            $('#recent-transactions-body').html('<tr><td colspan="4" class="text-center text-danger py-3">Failed to load.</td></tr>');
        }
    });
}
</script>

{{ footer }}