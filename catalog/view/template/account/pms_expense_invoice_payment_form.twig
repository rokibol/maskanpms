<div class="modal-dialog">
    <div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title"><i class="fa-solid fa-credit-card"></i> Record Payment</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
            <div class="alert alert-info">
                <strong>Invoice: {{ invoice_number }}</strong><br>
                Total Amount: ৳ {{ total_amount|number_format(2) }}<br>
                Paid Amount: ৳ {{ paid_amount|number_format(2) }}<br>
                Due Amount: ৳ {{ due_amount|number_format(2) }}
            </div>
            
            <form id="form-payment" action="{{ action }}" method="post" data-oc-toggle="ajax">
                <input type="hidden" name="invoice_id" value="{{ invoice_id }}">
                
                <div class="mb-3 required">
                    <label class="form-label">Payment Amount</label>
                    <input type="number" name="amount" class="form-control" step="0.01" min="0.01" max="{{ due_amount }}" required>
                    <small class="text-muted">Max: ৳ {{ due_amount|number_format(2) }}</small>
                </div>
                
                <div class="mb-3 required">
                    <label class="form-label">Payment Date</label>
                    <input type="date" name="payment_date" value="{{ "now"|date("Y-m-d") }}" class="form-control" required>
                </div>
                
                <div class="mb-3 required">
                    <label class="form-label">Payment Method</label>
                    <select name="payment_method" class="form-select" required>
                        <option value="">-- Select Method --</option>
                        {% for method_key, method_name in payment_methods %}
                            <option value="{{ method_key }}">{{ method_name }}</option>
                        {% endfor %}
                    </select>
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Reference Number</label>
                    <input type="text" name="reference_number" class="form-control" placeholder="Transaction ID / Cheque No / bKash Ref">
                </div>
                
                <div class="mb-3">
                    <label class="form-label">Notes</label>
                    <textarea name="notes" rows="2" class="form-control" placeholder="Optional notes"></textarea>
                </div>
                
                <input type="hidden" name="user_token" value="{{ user_token }}">
            </form>
        </div>
        <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" form="form-payment" class="btn btn-primary">Record Payment</button>
        </div>
    </div>
</div>