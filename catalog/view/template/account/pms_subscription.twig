<script>
// Replace the existing payment modal script with this
$(document).ready(function() {
    var selectedMonths = null;
    var selectedAmount = null;
    var selectedLabel = null;
    
    $('.duration-option').on('click', function() {
        $('.duration-option').removeClass('selected');
        $(this).addClass('selected');
        
        selectedMonths = $(this).data('months');
        selectedLabel = $(this).find('.duration-label').text();
        selectedAmount = $(this).find('.duration-price').text().trim();
        
        $('#selected-duration').val(selectedMonths);
        $('#btn-activate').prop('disabled', false);
    });
    
    $('#btn-activate').on('click', function() {
        if (selectedMonths) {
            // Direct redirect to payment request form
            window.location.href = 'index.php?route=account/pms_subscription_payment_request&duration=' + selectedMonths;
        }
    });
});
</script>

{{ footer }}