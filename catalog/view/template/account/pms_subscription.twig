{{ header }}

<style>
    .subscription-card {
        background: white;
        border: 1px solid #e0e0e0;
        border-radius: 10px;
        margin-bottom: 20px;
        overflow: hidden;
    }
    .card-header {
        background: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 1px solid #e0e0e0;
        font-weight: 600;
        font-size: 16px;
    }
    .card-body {
        padding: 20px;
    }
    .calc-box {
        background: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        margin: 15px 0;
        border: 1px solid #e0e0e0;
    }
    .calc-row {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid #e0e0e0;
    }
    .calc-row:last-child {
        border-bottom: none;
    }
    .calc-label {
        color: #555;
    }
    .calc-value {
        font-weight: 600;
        color: #333;
    }
    .calc-total {
        font-size: 18px;
        color: #1F8A4D;
    }
    .discount-badge {
        background: #F59E0B;
        color: white;
        padding: 2px 10px;
        border-radius: 20px;
        font-size: 11px;
        display: inline-block;
    }
    .duration-option {
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 10px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    .duration-option:hover {
        border-color: #1F8A4D;
        background: #f8f9fa;
    }
    .duration-option.selected {
        border-color: #1F8A4D;
        background: #e8f5e9;
    }
    .duration-label {
        font-weight: 600;
        font-size: 16px;
    }
    .duration-price {
        font-size: 18px;
        font-weight: 700;
        color: #1F8A4D;
    }
    .duration-price .per-month {
        font-size: 13px;
        font-weight: 400;
        color: #6c757d;
    }
    .btn-activate {
        background: #1F8A4D;
        color: white;
        border: none;
        padding: 12px 30px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        width: 100%;
        margin-top: 20px;
    }
    .btn-activate:hover {
        background: #166d3e;
    }
    .btn-activate:disabled {
        background: #ccc;
        cursor: not-allowed;
    }
    .rate-info {
        background: #e8f0fe;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 20px;
    }
    .rate-amount {
        font-size: 36px;
        font-weight: 700;
        color: #0B3C5D;
    }
    .project-rate {
        font-size: 14px;
        color: #6c757d;
    }
    .project-name {
        font-size: 20px;
        font-weight: 700;
        color: #0B3C5D;
        margin-bottom: 5px;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ heading_title }}</h1>
                <a href="{{ back }}" class="btn btn-secondary">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
            </div>
            
            <!-- Project Name -->
            <div class="project-name">{{ project_name }}</div>
            
            <!-- Current Subscription -->
            <div class="subscription-card">
                <div class="card-header">
                    <i class="fa-solid fa-chart-line"></i> Current Subscription
                </div>
                <div class="card-body">
                    {% if subscription and is_active %}
                        <div class="calc-box">
                            <div class="calc-row">
                                <span class="calc-label">Apartments</span>
                                <span class="calc-value">{{ subscription.apartment_count }}</span>
                            </div>
                            <div class="calc-row">
                                <span class="calc-label">Duration</span>
                                <span class="calc-value">{{ subscription.duration_months }} month(s)</span>
                            </div>
                            <div class="calc-row">
                                <span class="calc-label">Rate per Apartment</span>
                                <span class="calc-value">৳ {{ calculation.rate_per_apartment|number_format(2) }}</span>
                            </div>
                            {% if subscription.discount_type != 'none' and subscription.discount_value > 0 %}
                            <div class="calc-row">
                                <span class="calc-label">Discount</span>
                                <span class="calc-value">
                                    <span class="discount-badge">
                                        {% if subscription.discount_type == 'percentage' %}
                                            - {{ subscription.discount_value }}%
                                        {% else %}
                                            - ৳ {{ subscription.discount_value|number_format(2) }} / apt
                                        {% endif %}
                                    </span>
                                    <br>
                                    <small class="text-muted">{{ subscription.discount_reason }}</small>
                                </span>
                            </div>
                            {% endif %}
                            <div class="calc-row calc-total">
                                <span class="calc-label">Total Paid</span>
                                <span class="calc-value">৳ {{ subscription.total_amount|number_format(2) }}</span>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <strong>Status:</strong>
                                {% if is_active %}
                                    <span class="badge bg-success">Active</span>
                                {% else %}
                                    <span class="badge bg-danger">Expired</span>
                                {% endif %}
                            </div>
                            <div class="col-md-6">
                                <strong>Expires on:</strong> {{ subscription.end_date|date('d M Y') }}
                            </div>
                        </div>
                        {% if expiry_days > 0 and expiry_days <= 15 %}
                            <div class="alert alert-warning mt-3">
                                <i class="fas fa-regular fa-clock"></i>
                                <strong>Your subscription will expire in {{ expiry_days }} days!</strong>
                                Please renew below.
                            </div>
                        {% endif %}
                    {% else %}
                        <div class="alert alert-warning mb-0">
                            <i class="fas fa-regular fa-circle-exclamation"></i>
                            No active subscription found. Please select a plan below.
                        </div>
                    {% endif %}
                </div>
            </div>
            
            <!-- Pricing Info -->
            <div class="subscription-card">
                <div class="card-header">
                    <i class="fa-solid fa-tag"></i> Project Pricing
                </div>
                <div class="card-body">
                    <div class="rate-info">
                        <div class="rate-amount">৳ {{ calculation.rate_per_apartment|number_format(2) }}</div>
                        <div>per apartment per month</div>
                        <div class="project-rate">Total Apartments: {{ calculation.apartment_count }}</div>
                    </div>
                    <div class="calc-box">
                        <div class="calc-row">
                            <span class="calc-label">Total Apartments</span>
                            <span class="calc-value">{{ calculation.apartment_count }}</span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Base Monthly</span>
                            <span class="calc-value">৳ {{ calculation.base_monthly|number_format(2) }}</span>
                        </div>
                        {% if calculation.has_discount %}
                        <div class="calc-row">
                            <span class="calc-label">Discount</span>
                            <span class="calc-value">
                                <span class="discount-badge">
                                    {% if calculation.discount_type == 'percentage' %}
                                        - {{ calculation.discount_value }}%
                                    {% else %}
                                        - ৳ {{ calculation.discount_per_apartment|number_format(2) }} / apt
                                    {% endif %}
                                </span>
                                <br>
                                <small class="text-muted">{{ calculation.discount_reason }}</small>
                            </span>
                        </div>
                        <div class="calc-row">
                            <span class="calc-label">Effective Rate</span>
                            <span class="calc-value">৳ {{ calculation.effective_rate|number_format(2) }} / apt / mo</span>
                        </div>
                        {% endif %}
                        <div class="calc-row calc-total">
                            <span class="calc-label">Monthly Subscription</span>
                            <span class="calc-value">৳ {{ calculation.final_monthly|number_format(2) }}</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- Duration Options -->
            <div class="subscription-card">
                <div class="card-header">
                    <i class="fa-solid fa-calendar"></i> Select Duration
                </div>
                <div class="card-body">
                    <div id="duration-options">
                        {% for months, label in duration_options %}
                            <div class="duration-option" data-months="{{ months }}">
                                <div>
                                    <span class="duration-label">{{ label }}</span>
                                    {% if months >= 12 %}
                                        <span class="badge bg-success ms-2">Save {{ ((months * calculation.final_monthly - duration_amounts[months]) / (months * calculation.final_monthly) * 100)|round }}%</span>
                                    {% endif %}
                                </div>
                                <div>
                                    <span class="duration-price">
                                        ৳ {{ duration_amounts[months]|number_format(2) }}
                                        <span class="per-month">(৳ {{ (duration_amounts[months] / months)|number_format(2) }}/mo)</span>
                                    </span>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                    
                    <input type="hidden" id="selected-duration" value="">
                    
                    <button type="button" id="btn-activate" class="btn-activate" disabled>
                        <i class="fa-regular fa-credit-card"></i> Continue to Payment
                    </button>
                </div>
            </div>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

<!-- Payment Modal -->
