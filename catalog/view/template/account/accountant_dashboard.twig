{{ header }}
{# ==================== MAIN CONTAINER ==================== #}
<div id="account-account" class="container-fluid pms-accountant-dashboard">
    {# Success/Error Alerts #}
    {% if success %}
        <div class="alert alert-success alert-dismissible">
            <i class="fas fa-solid fa-circle-check"></i> {{ success }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}
    
    {% if error_warning %}
        <div class="alert alert-danger alert-dismissible">
            <i class="fas fa-solid fa-circle-exclamation"></i> {{ error_warning }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endif %}
    
    <div class="row">
        
        {# Left Column - Sidebar #}
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        {# Main Content Area #}
        <div id="content" class="col-lg-9 col-md-8">
            {{ content_top }}
            
            {# ==================== WELCOME HERO SECTION ==================== #}
            <div class="pms-welcome-hero">
                <div class="d-flex justify-content-between align-items-start flex-wrap">
                    <div>
                        <h2>Welcome back, {{ accountant_name }}!</h2>
                        <p>Manage expenses, track payments, and oversee financial records.</p>
                        <div class="mt-2 d-flex flex-wrap gap-2">
                            <span class="pms-badge">
                                <i class="fas fa-regular fa-building"></i> {{ project_name }}
                            </span>
                            <span class="pms-badge">
                                <i class="fas fa-regular fa-calendar"></i> {{ current_month }} {{ current_year }}
                            </span>
                        </div>
                    </div>
                    <div class="mt-2 mt-sm-0">
                        <small class="opacity-75">Last login: {{ last_login|default('Today') }}</small>
                    </div>
                </div>
            </div>
            
            {# ==================== KEY METRICS ROW ==================== #}
            <div class="row g-3 mb-3">
                <div class="col-6">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon primary-bg">
                            <i class="fas fa-regular fa-receipt"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Total Expenses</div>
                            <div class="pms-stat-value">৳ {{ monthly_expenses|default('0') }}</div>
                            <div class="pms-stat-sub">{{ expense_count|default('0') }} transactions this month</div>
                        </div>
                    </div>
                </div>
                <div class="col-6">
                    <div class="pms-stat-card">
                        <div class="pms-stat-icon green-bg">
                            <i class="fas fa-regular fa-credit-card"></i>
                        </div>
                        <div class="pms-stat-body">
                            <div class="pms-stat-label">Total Collections</div>
                            <div class="pms-stat-value">৳ {{ monthly_collections|default('0') }}</div>
                            <div class="pms-stat-sub">{{ payment_count|default('0') }} payments received</div>
                        </div>
                    </div>
                </div>
            </div>
            
            {# ==================== RECENT EXPENSES ==================== #}
            <div class="pms-card">
                <div class="pms-section-header">
                    <h4 class="pms-section-title">
                        <i class="fas fa-regular fa-receipt"></i> Recent Expenses
                    </h4>
                    <button type="button" id="btn-load-expenses" class="btn btn-sm btn-outline-primary">
                        <i class="fas fa-sync-alt"></i> Load Expenses
                    </button>
                </div>
                
                <div class="table-responsive" id="recent_expense_table_container">
                    <table class="pms-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Invoice #</th>
                                <th>Supplier</th>
                                <th>Payment Count</th>
                                <th>Paid Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="expenses-table-body">
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <button id="btn-load-expenses-initial" class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye"></i> Load Recent Expenses
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            {# ==================== RECENT PAYMENTS ==================== #}
            <div class="pms-card">
                <div class="pms-section-header">
                    <h4 class="pms-section-title">
                        <i class="fas fa-regular fa-credit-card"></i> Recent Payments
                    </h4>
                    <button type="button" id="btn-load-payments" class="btn btn-sm btn-outline-success">
                        <i class="fas fa-sync-alt"></i> Load Payments
                    </button>
                </div>
                
                <div class="table-responsive" id="recent_payments_container">
                    <table class="pms-table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Shareholder</th>
                                <th>Phase</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody id="payments-table-body">
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    <button id="btn-load-payments-initial" class="btn btn-primary btn-sm">
                                        <i class="fas fa-eye"></i> Load Recent Payments
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            
            {{ content_bottom }}
        </div>
        
    </div>
</div>
<script>
$(document).ready(function() {
    $("#recent_expense_table_container").hide();
    $("#recent_payments_container").hide();
    // ---- Load Recent Expenses ---- //
    function loadExpenses() {
        $("#recent_expense_table_container").show();

        $('#expenses-table-body').html('<tr><td colspan="7" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br>Loading expenses...</td></tr>');
        
        $.ajax({
            url: 'index.php?route=account/accountant.loadRecentExpenses&language={{ language }}&customer_token={{ customer_token }}',
            type: 'GET',
            success: function(html) {
                $('#expenses-table-body').html(html);
            },
            error: function() {
                $('#expenses-table-body').html('<tr><td colspan="6" class="text-center text-danger py-4">Failed to load expenses.</td></tr>');
            }
        });
    }

    $('#btn-load-expenses, #btn-load-expenses-initial').on('click', function() {
        loadExpenses();
    });

    // ---- Load Recent Payments ---- //
    function loadPayments() {
        $("#recent_payments_container").show();
        $('#payments-table-body').html('<tr><td colspan="4" class="text-center py-4"><i class="fas fa-spinner fa-spin fa-2x text-primary"></i><br>Loading payments...</td></tr>');
        
        $.ajax({
            url: 'index.php?route=account/accountant.loadRecentPayments&language={{ language }}&customer_token={{ customer_token }}',
            type: 'GET',
            success: function(html) {
                $('#payments-table-body').html(html);
            },
            error: function() {
                $('#payments-table-body').html('<tr><td colspan="4" class="text-center text-danger py-4">Failed to load payments.</td></tr>');
            }
        });
    }

    $('#btn-load-payments, #btn-load-payments-initial').on('click', function() {
        loadPayments();
    });
});
</script>
{{ footer }}