{{ header }}

<style>
    .item-row {
        background: #f8f9fa;
        padding: 15px;
        margin-bottom: 15px;
        border-radius: 8px;
        border-left: 4px solid #1F8A4D;
    }
    .calc-total {
        background: #e8f0fe;
        padding: 15px;
        border-radius: 8px;
        margin-top: 20px;
    }
    .btn-add-item {
        margin-top: 15px;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-lg-3 col-md-4">
            {{ column_left }}
        </div>
        
        <div id="content" class="col">
            {{ content_top }}
            
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>{{ text_form }}</h1>
                <div>
                    <button type="submit" form="form-invoice" class="btn btn-primary">
                        <i class="fa-regular fa-floppy-disk"></i> {{ button_save }}
                    </button>
                    <a href="{{ back }}" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left"></i> {{ button_back }}
                    </a>
                </div>
            </div>
            
            <form id="form-invoice" action="{{ action }}" method="post" data-oc-toggle="ajax">
                <input type="hidden" name="items_json" id="items-json" value="">
                
                <div class="card mb-3">
                    <div class="card-header">Invoice Information</div>
                    <div class="card-body">
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Select Supplier</label>
                            <div class="col-sm-9">
                                <select name="supplier_id" class="form-select" required>
                                    <option value="">-- Select Supplier --</option>
                                    {% for supplier in suppliers %}
                                        <option value="{{ supplier.supplier_id }}" {{ supplier_id == supplier.supplier_id ? 'selected' : '' }}>
                                            {{ supplier.supplier_name }} {{ supplier.company_name ? '(' ~ supplier.company_name ~ ')' : '' }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Invoice Number</label>
                            <div class="col-sm-9">
                                <input type="text" name="invoice_number" value="{{ invoice_number }}" class="form-control" required>
                            </div>
                        </div>
                        
                        <div class="row mb-3 required">
                            <label class="col-sm-3 col-form-label">Invoice Date</label>
                            <div class="col-sm-9">
                                <input type="date" name="invoice_date" value="{{ invoice_date }}" class="form-control" required>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Due Date</label>
                            <div class="col-sm-9">
                                <input type="date" name="due_date" value="{{ due_date }}" class="form-control">
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Currency</label>
                            <div class="col-sm-9">
                                <select name="currency" class="form-select">
                                    <option value="BDT" {{ currency == 'BDT' ? 'selected' : '' }}>BDT - Bangladeshi Taka</option>
                                    <option value="USD" {{ currency == 'USD' ? 'selected' : '' }}>USD - US Dollar</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Invoice Document</label>
                            <div class="col-sm-9">
                                <div id="document-upload-area">
                                    <input type="file" name="invoice_document" id="invoice-document" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx">
                                    <small class="text-muted">Allowed: PDF, JPG, PNG, DOC (Max: 5MB)</small>
                                    
                                    <div id="document-preview" style="display: none; margin-top: 10px;">
                                        <div class="alert alert-info">
                                            <i class="fa-regular fa-file-pdf"></i>
                                            <span id="document-filename"></span>
                                            <button type="button" id="remove-document" class="btn btn-danger btn-sm float-end">
                                                <i class="fa-regular fa-trash-can"></i> Remove
                                            </button>
                                        </div>
                                        <input type="hidden" name="existing_document" id="existing-document" value="{{ invoice_document }}">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="fa-solid fa-list"></i> Invoice Items
                        <button type="button" class="btn btn-success btn-sm float-end" onclick="addItemRow()">
                            <i class="fa-solid fa-plus"></i> Add Item
                        </button>
                    </div>
                    <div class="card-body" id="items-container">
                        <div id="items-list">
                            <!-- Items will be added here dynamically -->
                        </div>
                    </div>
                </div>
                
                <div class="card mb-3">
                    <div class="card-header">Additional Information</div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Tax Amount</label>
                            <div class="col-sm-9">
                                <input type="number" name="tax_amount" id="tax-amount" value="{{ tax_amount }}" class="form-control" step="1" min="0">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Discount Amount</label>
                            <div class="col-sm-9">
                                <input type="number" name="discount_amount" id="discount-amount" value="{{ discount_amount }}" class="form-control" step="1" min="0">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-sm-3 col-form-label">Notes</label>
                            <div class="col-sm-9">
                                <textarea name="notes" rows="3" class="form-control">{{ notes }}</textarea>
                            </div>
                        </div>
                        
                        <div class="calc-total">
                            <div class="row">
                                <div class="col-md-6 offset-md-6">
                                    <div class="d-flex justify-content-between mb-2">
                                        <strong>Sub Total:</strong>
                                        <span id="display-sub-total">0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tax:</span>
                                        <span id="display-tax">0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Discount:</span>
                                        <span id="display-discount">0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between fw-bold fs-5">
                                        <span>Total Amount:</span>
                                        <span id="display-total" class="text-danger">0.00</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <input type="hidden" name="sub_total" id="sub-total" value="0">
                <input type="hidden" name="total_amount" id="total-amount" value="0">
                <input type="hidden" name="customer_token" value="{{ customer_token }}">
                <input type="hidden" name="language" value="{{ language }}">
            </form>
            
            {{ content_bottom }}
        </div>
        
        {{ column_right }}
    </div>
</div>

<script>
// Global variables
var itemCount = 0;
var items = [];

// Categories from PHP (passed from controller)
var categories = {{ categories|json_encode|raw }};

// Function to add new item row
function addItemRow() {
    items.push({
        category_id: '',
        description: '',
        quantity: 1,
        unit_price: 0,
        total_price: 0,
        notes: ''
    });
    renderItems();
}

// Function to remove item
function removeItem(index) {
    if (confirm('Remove this item?')) {
        items.splice(index, 1);
        renderItems();
    }
}

// Function to update item field
function updateItem(index, field, value) {
    items[index][field] = value;
    if (field === 'quantity' || field === 'unit_price') {
        items[index].total_price = parseFloat(items[index].quantity) * parseFloat(items[index].unit_price);
        if (isNaN(items[index].total_price)) items[index].total_price = 0;
    }
    renderUpdatedValues(index, items[index].total_price);
    calculateTotals();
}

function renderUpdatedValues(index, value) {
    $("#total_"+index+"_total_price").val(value);
    
}

// Function to escape HTML
function escapeHtml(text) {
    if (!text) return '';
    return String(text).replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

// Function to render all items
function renderItems() {
    
    var html = '';
    for (var i = 0; i < items.length; i++) {
        var item = items[i];
        html += '<div class="item-row" data-index="' + i + '">';
        html += '<div class="row mb-3">';
        html += '<div class="col-md-3">';
        html += '<label class="form-label">Category</label>';
        html += '<select class="form-select category-updater" name="category_id" data-index="'+i+'">';
        html += '<option value="">-- Select Category --</option>';
        for (var j = 0; j < categories.length; j++) {
            var selected = (item.expense_category_id == categories[j].id) ? 'selected' : '';
            var indent = '';
            for (var k = 0; k < (categories[j].level || 0); k++) indent += '--';
            html += '<option value="' + categories[j].id + '" ' + selected + '>' + indent + ' ' + categories[j].category_name + '</option>';
        }
        html += '</select>';
        html += '</div>';
        html += '<div class="col-md-4">';
        html += '<label class="form-label">Description</label>';
        html += '<input type="text" class="form-control" value="' + escapeHtml(item.item_description) + '" onchange="updateItem(' + i + ', \'description\', this.value)">';
        html += '</div>';
        html += '<div class="col-md-1">';
        html += '<label class="form-label">Qty</label>';
        html += '<input type="number" class="form-control" step="1" value="' + item.quantity + '" onchange="updateItem(' + i + ', \'quantity\', parseFloat(this.value))">';
        html += '</div>';
        html += '<div class="col-md-2">';
        html += '<label class="form-label">Unit Price</label>';
        html += '<input type="number" class="form-control" step="1" value="' + item.unit_price + '" onchange="updateItem(' + i + ', \'unit_price\', parseFloat(this.value))">';
        html += '</div>';
        html += '<div class="col-md-1">';
        html += '<label class="form-label">Total</label>';
        html += '<input type="text" id="total_'+i+'_total_price" class="form-control" readonly value="' + item.total_price + '">';
        html += '</div>';
        html += '<div class="col-md-1 text-end">';
        html += '<label class="form-label">&nbsp;</label><br>';
        html += '<button type="button" class="btn btn-danger btn-sm" onclick="removeItem(' + i + ')"><i class="fa-regular fa-trash-can"></i></button>';
        html += '</div>';
        html += '</div>';
        html += '<div class="row">';
        html += '<div class="col-md-12">';
        html += '<label class="form-label">Notes</label>';
        html += '<textarea class="form-control" rows="2" onchange="updateItem(' + i + ', \'notes\', this.value)">' + escapeHtml(item.notes) + '</textarea>';
        html += '</div>';
        html += '</div>';
        html += '</div>';
    }
    $('#items-list').html(html);
    calculateTotals();
}

// Function to calculate totals
function calculateTotals() {
    var subTotal = 0;
    for (var i = 0; i < items.length; i++) {
        subTotal += parseFloat(items[i].total_price) || 0;
    }
    
    var tax = parseFloat($('#tax-amount').val()) || 0;
    var discount = parseFloat($('#discount-amount').val()) || 0;
    var total = subTotal + tax - discount;
    
    $('#display-sub-total').text(subTotal.toFixed(2));
    $('#display-tax').text(tax.toFixed(2));
    $('#display-discount').text(discount.toFixed(2));
    $('#display-total').text(total.toFixed(2));
    
    $('#sub-total').val(subTotal);
    $('#total-amount').val(total);
    $('#items-json').val(JSON.stringify(items));
}

document.addEventListener('change', function(event) {
    // Check if the changed element has our specific target class
    if (event.target.classList.contains('category-updater')) {
        const select = event.target;
        
        const index = select.getAttribute('data-index'); // Retrieves the loop index
        const name  = select.name;                        // Retrieves "category_id"
        const value = select.value;                       // Retrieves the selected option's value
        
        // Execute your custom function
        updateItem(index, name, value);
    }
});


// Document upload handling
$(document).ready(function() {
    // Load existing items if editing
    {% if invoice_items %}
        var existingItems = {{ invoice_items|json_encode|raw }};
        items = existingItems;
        renderItems();
    {% else %}
        // Add one empty item row by default
        addItemRow();
    {% endif %}
    
    // Calculate totals when tax or discount changes
    $('#tax-amount, #discount-amount').on('input', calculateTotals);
    
    // Document upload handling
    var existingDocument = $('#existing-document').val();
    if (existingDocument) {
        $('#document-preview').show();
        $('#document-filename').text(existingDocument.split('/').pop());
    }
    
    $('#invoice-document').on('change', function() {
        var file = this.files[0];
        if (!file) return;
        
        if (file.size > 5242880) {
            alert('File size too large. Maximum 5MB allowed.');
            $(this).val('');
            return;
        }
        
        var allowedExtensions = ['pdf', 'jpg', 'jpeg', 'png', 'doc', 'docx'];
        var fileExt = file.name.split('.').pop().toLowerCase();
        if (!allowedExtensions.includes(fileExt)) {
            alert('Invalid file type. Allowed: PDF, JPG, PNG, DOC, DOCX');
            $(this).val('');
            return;
        }
        
        var formData = new FormData();
        formData.append('file', file);
        formData.append('user_token', '{{ user_token }}');
        
        $.ajax({
            url: 'index.php?route=account/pms_expense_invoices.uploadDocument&language={{ language }}&customer_token={{ customer_token }}',
            type: 'POST',
            data: formData,
            dataType: 'json',
            contentType: false,
            processData: false,
            beforeSend: function() {
                $('#invoice-document').prop('disabled', true);
                $('#invoice-document').after('<div class="spinner-border spinner-border-sm ms-2" id="upload-spinner"></div>');
            },
            success: function(json) {
                if (json.success) {
                    $('#document-preview').show();
                    $('#document-filename').text(json.filename);
                    $('#existing-document').val(json.file_path);
                    $('#invoice-document').val('');
                } else {
                    alert(json.error);
                }
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert('Upload failed: ' + thrownError);
            },
            complete: function() {
                $('#invoice-document').prop('disabled', false);
                $('#upload-spinner').remove();
            }
        });
    });
    
    $('#remove-document').on('click', function() {
        var filePath = $('#existing-document').val();
        if (filePath && confirm('Are you sure you want to remove this document?')) {
            $.ajax({
                url: 'index.php?route=account/pms_expense_invoices.deleteDocument&language={{ language }}&file_path=' + encodeURIComponent(filePath) + '&user_token={{ user_token }}',
                type: 'GET',
                dataType: 'json',
                success: function(json) {
                    if (json.success) {
                        $('#document-preview').hide();
                        $('#existing-document').val('');
                        $('#invoice-document').val('');
                    } else {
                        alert(json.error);
                    }
                }
            });
        }
    });
});
</script>

{{ footer }}